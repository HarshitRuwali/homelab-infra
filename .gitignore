.env
*.local
*.log
.DS_Store

# Local runtime files if you add bind mounts or ad hoc exports. Keep this out of git.
data/
logs/

# Ansible.
# NOTE: inventory/group_vars/all/vault.yml IS committed on purpose. It is
# ansible-vault encrypted; the point is encrypted-at-rest in git. The vault
# password itself lives at ~/.config/ansible/monitorting-vault-pass, outside
# this repo, and must be backed up separately.
#
# `*.local` above only matches names ENDING in .local, so it would not catch
# secrets.local.yml. Hence the explicit pattern below.
ansible/*.retry
ansible/.vault-pass
ansible/**/*.local.yml
ansible/collections/
ansible/roles/**/files/*.local

# MkDocs build output. Generated by `mkdocs build`; never committed.
site/

# uv-managed virtualenv. uv.lock IS committed (it pins the exact tool
# versions); the environment it builds is not.
.venv/
__pycache__/
*.pyc

# Editor and tooling noise.
.vscode/
.idea/
node_modules/
