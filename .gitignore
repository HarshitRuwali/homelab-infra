.DS_Store
*.log
.env
.envrc

# Ansible.
# NOTE: inventory/group_vars/all/vault.yml IS committed on purpose. It is
# ansible-vault encrypted; the point is encrypted-at-rest in git. The vault
# password itself lives at ~/.config/ansible/monitorting-vault-pass, outside
# this repo, and must be backed up separately.
#
# A bare `*.local` pattern only matches names ENDING in .local, so it would
# not catch secrets.local.yml. Hence the explicit patterns below.
ansible/*.retry
ansible/.vault-pass
ansible/**/*.local.yml
ansible/collections/
ansible/roles/**/files/*.local

# MkDocs build output and local docs virtualenv for the fleet site. The pinned
# toolchain in ansible/docs/requirements.txt IS committed; the environment and
# the rendered site are not. The other stacks carry the same rules in their own
# .gitignore files.
ansible/site/
ansible/.venv/
ansible/venv/

# Combined MkDocs output built by .github/workflows/deploy-docs.yml.
/site/

# AI coding-agent scratch and config. This repository is public and these files
# are working notes, not documentation: the one that was committed carried a
# real tailnet address and a stale plan. Keep them out of git entirely.
.agent/
AGENTS.md
CLAUDE.md
GEMINI.md
.cursorrules
.cursor/
.aider*
.claude/
