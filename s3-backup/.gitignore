# Never commit real config or secrets
config/backup.env
config/*.local
*.password
restic-password*
.staging/
*.log

# MkDocs build output. Generated by `mkdocs build`; never committed.
site/

# Local virtualenv for building the docs. Versions are pinned in
# docs/requirements.txt, which IS committed; the environment is not.
.venv/
venv/
__pycache__/
*.pyc
