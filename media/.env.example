# Copied to MEDIA_DIR/.env by install.sh on the first run, then left alone.
# No secrets here: they go in MEDIA_DIR/secrets (see docs/secrets.md).

# Time zone for the containers' logs and schedules.
TZ=Asia/Kolkata

# Where this stack lives on the host: compose.yaml, .env, config, secrets.
# Chosen at install time with `MEDIA_DIR=/path ./install.sh --apply`. Do not
# edit it in the installed .env afterwards: install.sh refuses to run if it
# differs from the MEDIA_DIR in use.
MEDIA_DIR=/opt/media

# The media share. Plex reads it; qBittorrent writes to MEDIA_ROOT/Torrent.
MEDIA_ROOT=/mnt/storage

# Owner of the files on the share, so downloads keep the same owner as the
# rest of it. On cloud-services the virtiofs share is owned by 100000:100000.
MEDIA_UID=100000
MEDIA_GID=100000

# qBittorrent WebUI port, on 127.0.0.1 and the tailnet only. Not 8000: that
# is gluetun's control server inside the shared network namespace. Not 8080:
# Nextcloud on cloud-services.
QBT_WEBUI_PORT=8081

# Memory caps per container (Docker size strings). The host has no swap and is
# shared with Immich and Nextcloud, so these keep one runaway container from
# taking everything. Sized from 7-day peaks (plex 700 MiB, qbittorrent 132,
# gluetun 83, cloudflared 53) with headroom. A container over its cap is
# OOM-killed and restarted by `restart: unless-stopped`. Raise one here if its
# peak grows; compose.yaml carries the same defaults for an older installed .env.
PLEX_MEM_LIMIT=1536m
QBT_MEM_LIMIT=512m
GLUETUN_MEM_LIMIT=192m
PLEX_TUNNEL_MEM_LIMIT=128m

# plex-tunnel's metrics endpoint, on 127.0.0.1 of the host (host network). Its
# healthcheck queries it. Change it only if the port is taken.
PLEX_TUNNEL_METRICS_PORT=20241
