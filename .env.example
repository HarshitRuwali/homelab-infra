# Open Memory Stack - root compose environment
# Copy to .env before running `docker compose up -d --build`.

POSTGRES_USER=open_memory
POSTGRES_PASSWORD=
POSTGRES_DB=open_memory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=memory
# VECTOR_DIM must equal the output dimension of the embedding model served at
# AI_VM_HOST:EMBED_PORT, and must match the existing Qdrant collection.
#   bge-large-en-v1.5    -> 1024
#   bge-base / all-mpnet -> 768
# The API validates this at startup and refuses to serve on a mismatch, so a
# wrong value here fails loudly instead of writing corrupt vectors.
# NOTE: this file configures the ALL-IN-ONE local stack (its own postgres/qdrant
# containers). A split deployment uses fastapi-lxc/.env instead, pointing at
# datastores on another host. Do not copy values between the two.
VECTOR_DIM=1024

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# Use host.docker.internal when your LLM and embedding services run on the same host.
# Set this to an IP or DNS name when they run elsewhere.
AI_VM_HOST=host.docker.internal
LLM_PORT=8080
EMBED_PORT=8081

APP_HOST=0.0.0.0
APP_PORT=8080
FASTAPI_PORT=8088
UVICORN_WORKERS=2
LOG_LEVEL=info
