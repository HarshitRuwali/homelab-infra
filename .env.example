# Open Memory Stack - root compose environment
# Copy to .env before running `docker compose up -d --build`.

POSTGRES_USER=open_memory
POSTGRES_PASSWORD=
POSTGRES_DB=open_memory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=memory
VECTOR_DIM=768

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# Use host.docker.internal when your LLM and embedding services run on the same host.
# Set this to an IP or DNS name when they run elsewhere.
AI_VM_HOST=host.docker.internal
LLM_PORT=8080
EMBED_PORT=8081

APP_HOST=0.0.0.0
APP_PORT=8080
FASTAPI_PORT=8088
UVICORN_WORKERS=2
LOG_LEVEL=info
