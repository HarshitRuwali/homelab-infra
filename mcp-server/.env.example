# Open Memory MCP server — environment
# These are passed through the MCP client config ("env" block), not read from a
# file; this sample just documents the knobs.

# Base URL of the FastAPI memory service.
OPEN_MEMORY_API_URL=http://localhost:8080

# Scope every write from this client. Give each connected agent a DISTINCT id —
# that is what stops two agents overwriting the same file_path + chunk_index.
OPEN_MEMORY_AGENT_ID=claude-code

# Project / worktree scope. Use one per checkout when several worktrees share
# similar relative paths.
OPEN_MEMORY_PROJECT=default

# Optional free-form session marker stored alongside each chunk (metadata only).
# OPEN_MEMORY_SESSION_ID=

# HTTP timeout in seconds.
OPEN_MEMORY_TIMEOUT=60
