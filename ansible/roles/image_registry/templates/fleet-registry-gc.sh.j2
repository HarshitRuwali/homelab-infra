#!/usr/bin/env bash
# Managed by ansible/roles/image_registry. Do not edit by hand.
# Rendered for {{ inventory_hostname }}.
#
# Garbage-collects the image registry: stops it, removes blobs no manifest
# refers to, starts it again. Collecting while the registry accepts pushes can
# delete a blob an upload is about to reference, so the registry is down for
# the run. The start is attempted whatever happens in between.

set -uo pipefail

COMPOSE=(docker compose --file "{{ image_registry_compose_file }}")
OUT_DIR="{{ image_registry_metrics_dir }}"
OUT_FILE="$OUT_DIR/{{ image_registry_metrics_file }}"

exec 9>/run/fleet-registry-gc.lock
if ! flock -n 9; then
  echo "fleet-registry-gc: another run holds the lock, skipping"
  exit 0
fi

started=$(date +%s)
ok=1

start_registry() {
  "${COMPOSE[@]}" up --detach || ok=0
}
trap start_registry EXIT

echo "fleet-registry-gc: stopping the registry"
if "${COMPOSE[@]}" stop registry; then
  echo "fleet-registry-gc: collecting"
  "${COMPOSE[@]}" run --rm --no-deps -T registry garbage-collect \
{% if image_registry_gc_delete_untagged | bool %}
    --delete-untagged \
{% endif %}
    "{{ image_registry_container_config }}" || ok=0
else
  ok=0
fi

# The EXIT trap starts the registry; run it now as well so the duration and
# the metric below describe a registry that is back, and so a failure to start
# is reflected in them.
trap - EXIT
start_registry

ended=$(date +%s)
if [ -d "$OUT_DIR" ]; then
  tmp="$(mktemp "$OUT_DIR/.registry-gc.XXXXXX")"
  cat > "$tmp" <<METRICS
# HELP fleet_registry_gc_last_run_timestamp_seconds Unix time the last registry garbage collection finished.
# TYPE fleet_registry_gc_last_run_timestamp_seconds gauge
fleet_registry_gc_last_run_timestamp_seconds $ended
# HELP fleet_registry_gc_last_success 1 if the last registry garbage collection succeeded and the registry restarted, else 0.
# TYPE fleet_registry_gc_last_success gauge
fleet_registry_gc_last_success $ok
# HELP fleet_registry_gc_duration_seconds Seconds the last registry garbage collection took, during which the registry was down.
# TYPE fleet_registry_gc_duration_seconds gauge
fleet_registry_gc_duration_seconds $((ended - started))
METRICS
  chmod 0644 "$tmp"
  mv "$tmp" "$OUT_FILE"
fi

echo "fleet-registry-gc: done, success=$ok"
[ "$ok" -eq 1 ]
