# Managed by ansible/roles/image_registry. Do not edit by hand.
#
# The project name is what the docker_updates role's skip list matches
# (docker_update_skip_projects).
name: {{ image_registry_project_name }}

services:
  registry:
    image: {{ image_registry_image }}
    restart: unless-stopped
    # Bound so the json-file driver cannot fill the disk with registry logs.
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    # Loopback only. `tailscale serve` is the way in from the tailnet.
    ports:
      - "127.0.0.1:{{ image_registry_port }}:5000"
    volumes:
      - {{ image_registry_data_dir }}:/var/lib/registry
      - {{ image_registry_config_file }}:{{ image_registry_container_config }}:ro
      # The directory is mounted, so the registry sees htpasswd as it is now.
      - {{ image_registry_auth_dir }}:/auth:ro
