apiVersion: 1

# GENERATED by ansible/roles/grafana_alerting from the inventory.
# Do not edit on the server: re-run playbooks/central-alerting.yml instead.
#
# Why this file is templated rather than committed like its siblings:
#
# This stack is push-based. prometheus/prometheus.yml has no scrape_configs
# for hosts; everything arrives through --web.enable-remote-write-receiver.
# So `up{job=~"integrations/unix|host-unix"}` is a series the collector PUSHES about itself.
# When a host dies it stops pushing and the series simply vanishes after the
# 5m lookback. It never becomes 0. A naive `up == 0` alert therefore never
# fires: it goes NoData, and a NoData instance carries no `host` label, so
# you cannot even tell which machine died.
#
# The fix is an `or` chain of per-host constant floors. `or` returns all
# left-hand samples plus right-hand samples whose FULL label set is unmatched
# on the left. After `max by (host)` the left label set is exactly {host="x"},
# and each vector(0) is also exactly {host="x"}, so the floor is suppressed
# while the host is alive and surfaces (with its host label intact) once the
# host stops reporting. vector(0) always returns a sample, so this expression
# can never be NoData.
#
# Generating it from the inventory means adding a host to hosts.yml cannot
# leave a silent gap in down-detection.

groups:
  - orgId: 1
    name: availability
    folder: Fleet
    interval: 1m
    rules:

      - uid: fleet-host-down
        title: Host Down
        condition: C
        for: 0m
        labels:
          severity: critical
        annotations:
          summary: No metrics received for over 10 minutes. The host or its Alloy collector is down.
          runbook: "tailscale ping <host>; ssh <host> systemctl status alloy"
        noDataState: OK
        execErrState: Error
        data:
          - refId: A
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              range: false
              expr: |
                max by (host) (max_over_time(up{job=~"integrations/unix|host-unix"}[10m]))
{% for h in (groups['monitored'] | sort) %}
                  or label_replace(vector(0), "host", "{{ hostvars[h].monitor_hostname | default(h) }}", "", "")
{% endfor %}
          - refId: B
            datasourceUid: __expr__
            model: {refId: B, type: reduce, expression: A, reducer: last}
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: {type: lt, params: [1]}

      # ---------------------------------------------------------------
      - uid: fleet-collector-lagging
        title: Collector Data Lagging
        condition: C
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: Metrics are arriving but over 15 minutes stale. Usually remote-write backpressure or 429s, not a dead host.
          runbook: "ssh <host> 'curl -s localhost:12345/metrics | grep remote_storage_samples_failed'"
        noDataState: OK
        execErrState: Error
        data:
          - refId: A
            relativeTimeRange: {from: 21600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              range: false
              # timestamp() inside a subquery evaluated at 1m steps recovers
              # the wall-clock time of the most recent sample, and keeps the
              # series alive for up to 6h after the host stops reporting.
              expr: time() - max by (host) (max_over_time(timestamp(up{job=~"integrations/unix|host-unix"})[6h:1m]))
          - refId: B
            datasourceUid: __expr__
            model: {refId: B, type: reduce, expression: A, reducer: last}
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: {type: gt, params: [900]}

      # ---------------------------------------------------------------
      - uid: fleet-remote-write-failing
        title: Alloy Remote Write Failing
        condition: C
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: Alloy is failing to remote-write samples. Check the collector password and the nginx ingest paths.
          runbook: "journalctl -u alloy -n 100 | grep -iE '401|429|error'"
        noDataState: OK
        execErrState: Error
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              range: false
              # Known blind spot: if remote write is TOTALLY down, the metric
              # proving it is also not arriving. fleet-host-down is the
              # backstop for that case.
              expr: sum by (host) (rate(prometheus_remote_storage_samples_failed_total[10m]))
          - refId: B
            datasourceUid: __expr__
            model: {refId: B, type: reduce, expression: A, reducer: last}
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: {type: gt, params: [0]}

      # ---------------------------------------------------------------
      - uid: fleet-clock-unsynced
        title: Clock Not Synchronised
        condition: C
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: System clock is not NTP-synchronised. Prometheus rejects samples too far in the future, so this silently loses data.
          runbook: "timedatectl status; systemctl status systemd-timesyncd"
        noDataState: OK
        execErrState: Error
        data:
          - refId: A
            relativeTimeRange: {from: 1800, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              range: false
              expr: min by (host) (node_timex_sync_status)
          - refId: B
            datasourceUid: __expr__
            model: {refId: B, type: reduce, expression: A, reducer: last}
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: {type: lt, params: [1]}

      # ---------------------------------------------------------------
      - uid: fleet-central-stack-down
        title: Central Stack Unit Down
        condition: C
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: A core service on the central monitoring LXC is not active.
          runbook: "ssh {{ central_host_label }} 'systemctl status prometheus loki grafana-server nginx alloy matrix-webhook'"
        noDataState: OK
        execErrState: Error
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: prometheus
            model:
              refId: A
              editorMode: code
              instant: true
              range: false
              expr: |
                max by (host, name) (
                  node_systemd_unit_state{host="{{ central_host_label }}",name=~"(prometheus|loki|grafana-server|nginx|alloy|matrix-webhook)\\.service",state="active"}
                )
          - refId: B
            datasourceUid: __expr__
            model: {refId: B, type: reduce, expression: A, reducer: last}
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: {type: lt, params: [1]}

# NOTE: none of these can tell you the central LXC itself is down, because
# Grafana dies with it. That needs an external dead-man's-switch (a
# healthchecks.io ping from an OnCalendar timer on the central box, or an
# Uptime Kuma elsewhere). See monitoring/docs/monitoring/alerting.md.
