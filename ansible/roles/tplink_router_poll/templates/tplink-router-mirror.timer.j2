# {{ ansible_managed }}
[Unit]
Description=Nightly copy of the TP-Link router {{ tplink_router_poll_mirror_src.tplink_router_poll_name }} data

[Timer]
# After the poller's first poll of the UTC day has written the new snapshot.
OnCalendar=*-*-* 01:30:00 UTC
RandomizedDelaySec=15m
# A host that was off at 01:30 copies when it next starts.
Persistent=true

[Install]
WantedBy=timers.target
