# Managed by ansible/roles/matrix_webhook. Do not edit by hand.
#
# Variable names are taken from `python -m matrix_webhook --help`, NOT from
# the project README, which documents different ones. Getting these wrong
# makes the unit crash-loop with "the following arguments are required".
#   HOST / PORT   (not API_HOST / API_PORT)
#   API_KEY       (not MATRIX_API_KEY)
MATRIX_URL={{ matrix_webhook_url }}
MATRIX_ID={{ matrix_webhook_id }}
MATRIX_PW={{ matrix_webhook_pw }}
API_KEY={{ matrix_webhook_api_key }}
HOST={{ matrix_webhook_listen_host }}
PORT={{ matrix_webhook_listen_port }}
