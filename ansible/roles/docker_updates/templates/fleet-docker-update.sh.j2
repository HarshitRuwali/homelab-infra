#!/usr/bin/env bash
# Managed by ansible/roles/docker_updates. Do not edit by hand.
# Rendered for {{ inventory_hostname }}.
#
# Pulls registry images and rebuilds local images against current base images
# for every Docker Compose project on this host, then applies changed images.
#
# WHY COMPOSE AND NOT WATCHTOWER
# Watchtower recreates a container from the *running* container's config. That
# config drifts from the compose file the moment anyone edits the compose file
# without redeploying, and the drift is silent and unrecoverable: the compose
# file stops being the source of truth. `docker compose up -d` re-reads the
# file every time, so the file stays authoritative and this script stays a
# scheduler rather than a second, competing deployment mechanism.
#
# DATABASE MAJORS
# PostgreSQL and MySQL tags float within their current major release. A new
# major needs a supervised data migration. Images listed in
# docker_update_minor_step_images (Qdrant) may advance only one minor release
# per run; a bigger jump keeps the current image and fails the run.
#
# The corollary is the thing to remember: if you ever retag a stateful service
# to `:latest` or to a bare major like `postgres`, this script can ask a new
# server to open an incompatible data directory at 04:00. Migrate those
# databases explicitly before changing their major image tag.

set -uo pipefail

OUT_DIR="{{ update_metrics_dir }}"
OUT_FILE="$OUT_DIR/{{ docker_update_metrics_file }}"
TMP_FILE="$(mktemp "$OUT_DIR/.docker-update.XXXXXX")"

SKIP_PROJECTS="{{ docker_update_skip_projects | join(' ') }}"
PRUNE="{{ docker_update_prune | ternary('yes', 'no') }}"
HEALTH_WAIT={{ docker_update_health_wait_seconds }}
RETRY_DELAY={{ docker_update_pull_retry_delay_seconds }}
MINOR_STEP_IMAGES="{{ docker_update_minor_step_images | join(' ') }}"

trap 'rm -f "$TMP_FILE"' EXIT

started=$(date +%s)
failed=0
projects_seen=0
projects_changed=0
containers_recreated=0

log() { echo "fleet-docker-update: $*"; }

# ---------------------------------------------------------------------------
# Discover Compose projects from the RUNNING containers rather than by
# scanning the filesystem for compose files. Scanning finds abandoned copies,
# half-finished experiments and backups; the labels describe only what is
# actually deployed right now.
#
# config_files is carried through because a project may not use the default
# docker-compose.yml name, and `docker compose` in the wrong directory with
# the wrong file silently creates a SECOND stack rather than updating the
# existing one.
# ---------------------------------------------------------------------------
discover() {
  local cid
  for cid in $(docker ps -q 2>/dev/null); do
    docker inspect "$cid" --format \
      '{{ '{{' }}index .Config.Labels "com.docker.compose.project"{{ '}}' }}|{{ '{{' }}index .Config.Labels "com.docker.compose.project.working_dir"{{ '}}' }}|{{ '{{' }}index .Config.Labels "com.docker.compose.project.config_files"{{ '}}' }}' \
      2>/dev/null
  done | grep -v '^|' | sort -u
}

is_skipped() {
  local p="$1" s
  for s in $SKIP_PROJECTS; do
    [ "$p" = "$s" ] && return 0
  done
  return 1
}

# Image IDs currently backing this project's containers. Comparing this before
# and after is how we know something really changed: `docker compose pull`
# reports "Pulled" even when every layer was already local, so its output is
# not a reliable signal.
project_image_ids() {
  local proj="$1" cid
  for cid in $(docker ps -q --filter "label=com.docker.compose.project=$proj" 2>/dev/null); do
    docker inspect "$cid" --format '{{ '{{' }}.Image{{ '}}' }}' 2>/dev/null
  done | sort
}

# One line per service: name, image as written in the compose file (empty for
# a build with no image:), and 1 if the service declares a build.
project_services() {
  docker compose "${compose_args[@]}" config --format json 2>/dev/null |
    python3 -c 'import json,sys; c=json.load(sys.stdin); [print(n, s.get("image", ""), int("build" in s), sep="\t") for n, s in c.get("services", {}).items()]'
}

# True for an image that exists here but never came from a registry: built
# locally and referenced only by `image:`. Pulling it would ask Docker Hub for
# a name nobody published and fail the whole project.
is_local_only() {
  [ "$(docker image inspect --format '{{ '{{' }}len .RepoDigests{{ '}}' }}' "$1" 2>/dev/null)" = "0" ]
}

is_minor_step() {
  local i
  for i in $MINOR_STEP_IMAGES; do
    [ "$1" = "$i" ] && return 0
  done
  return 1
}

# Version label of the project's running container that uses image $2.
running_version() {
  local cid
  for cid in $(docker ps -q --filter "label=com.docker.compose.project=$1" 2>/dev/null); do
    if [ "$(docker inspect --format '{{ '{{' }}.Config.Image{{ '}}' }}' "$cid" 2>/dev/null)" = "$2" ]; then
      docker inspect --format '{{ '{{' }}index .Config.Labels "org.opencontainers.image.version"{{ '}}' }}' "$cid" 2>/dev/null
      return
    fi
  done
}

# True when version $2 is the same minor as $1 or the next one. Anything else,
# including an unreadable version, needs a human.
minor_step_ok() {
  local re='^v?([0-9]+)\.([0-9]+)\.[0-9]+$' cmaj cmin
  [[ $1 =~ $re ]] || return 1
  cmaj=${BASH_REMATCH[1]} cmin=${BASH_REMATCH[2]}
  [[ $2 =~ $re ]] || return 1
  [ "${BASH_REMATCH[1]}" = "$cmaj" ] &&
    [ "${BASH_REMATCH[2]}" -ge "$cmin" ] &&
    [ "${BASH_REMATCH[2]}" -le $((cmin + 1)) ]
}

# Run a compose subcommand for the current project, retrying once. Registry
# hiccups (a Docker Hub 429, a short ghcr.io outage) usually clear within
# minutes; one retry keeps them from paging while a persistent failure still
# does.
compose_retry() {
  local what="$1" attempt
  shift
  for attempt in 1 2; do
    docker compose "${compose_args[@]}" "$@" 2>&1 | sed "s/^/  [$proj] /" && return 0
    if [ "$attempt" -eq 1 ]; then
      log "$proj: $what failed, retrying in ${RETRY_DELAY}s"
      sleep "$RETRY_DELAY"
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
while IFS='|' read -r proj workdir configs; do
  [ -n "$proj" ] || continue
  projects_seen=$((projects_seen + 1))

  if is_skipped "$proj"; then
    log "skipping $proj (in skip list)"
    continue
  fi

  if [ ! -d "$workdir" ]; then
    log "ERROR $proj: working_dir $workdir does not exist, cannot update"
    failed=1
    continue
  fi

  # Build the -f arguments. config_files is a comma-separated absolute path
  # list in every Compose v2 version we run.
  compose_args=(--project-name "$proj" --project-directory "$workdir")
  if [ -n "$configs" ]; then
    IFS=',' read -ra cfgs <<< "$configs"
    for c in "${cfgs[@]}"; do
      [ -f "$c" ] && compose_args+=(-f "$c")
    done
  fi

  before="$(project_image_ids "$proj")"

  if ! services="$(project_services)"; then
    log "ERROR $proj: docker compose config failed; run it in $workdir to see why"
    failed=1
    continue
  fi

  # Pull only what a registry can provide. Services with a build are rebuilt
  # against fresh base images below, and image-only local builds have nothing
  # to pull. Everything else must pull: a registry failure that survives the
  # retry is a real update failure, not something to hide.
  #
  # For minor-step images, remember what the tag points at now and which
  # version is running, so a jump that is too big can be undone before
  # anything is recreated.
  pull_services=()
  declare -A step_old_id=() step_current=()
  while IFS=$'\t' read -r svc img has_build; do
    [ -n "$svc" ] || continue
    if [ "$has_build" = "1" ]; then
      continue
    fi
    if is_local_only "$img"; then
      log "$proj: not pulling $svc, $img was built on this host"
      continue
    fi
    pull_services+=("$svc")
    if is_minor_step "$img"; then
      step_old_id[$img]="$(docker image inspect --format '{{ '{{' }}.Id{{ '}}' }}' "$img" 2>/dev/null || true)"
      step_current[$img]="$(running_version "$proj" "$img")"
    fi
  done <<< "$services"

  if [ -n "${pull_services[*]}" ]; then
    log "pulling $proj"
    if ! compose_retry pull pull "${pull_services[@]}"; then
      log "ERROR $proj: pull failed"
      failed=1
      continue
    fi
  fi

  # Qdrant migrates its storage on startup and supports only adjacent minor
  # releases. When the pull moved the tag further than that, point the tag
  # back at the old image: `up -d` then leaves that container alone, and so
  # does a later manual `docker compose up -d`. The rest of the project still
  # updates, and the run fails so the stepwise migration gets done.
  for img in "${!step_old_id[@]}"; do
    old_id="${step_old_id[$img]}"
    [ -n "$old_id" ] || continue    # first install: no data to migrate yet
    [ "$(docker image inspect --format '{{ '{{' }}.Id{{ '}}' }}' "$img" 2>/dev/null)" != "$old_id" ] || continue
    current="${step_current[$img]}"
    next="$(docker image inspect --format '{{ '{{' }}index .Config.Labels "org.opencontainers.image.version"{{ '}}' }}' "$img" 2>/dev/null)"
    if ! minor_step_ok "$current" "$next"; then
      docker tag "$old_id" "$img"
      log "ERROR $proj: $img ${current:-unknown} to ${next:-unknown} skips a minor release; kept ${current:-the current image}. Step through each minor with upgrade-qdrant-stepwise.sh"
      failed=1
    fi
  done

  log "building $proj with fresh base images"
  if ! compose_retry build build --pull; then
    log "ERROR $proj: build failed"
    failed=1
    continue
  fi

  # Recreates ONLY containers whose image changed. Deliberately no
  # --remove-orphans: that deletes containers this project did not create,
  # which on a shared host means deleting something a human started by hand.
  log "applying $proj"
  if ! docker compose "${compose_args[@]}" up -d 2>&1 | sed "s/^/  [$proj] /"; then
    log "ERROR $proj: up -d failed"
    failed=1
    continue
  fi

  after="$(project_image_ids "$proj")"
  if [ "$before" != "$after" ]; then
    projects_changed=$((projects_changed + 1))
    changed_here=$(comm -13 <(echo "$before") <(echo "$after") | wc -l)
    containers_recreated=$((containers_recreated + changed_here))
    log "$proj: $changed_here container(s) now on a new image"
  else
    log "$proj: already up to date"
  fi
done < <(discover)

# ---------------------------------------------------------------------------
# Verify the host actually came back up. A pull that succeeds and an `up -d`
# that returns 0 can still leave a container crash-looping on a new image, and
# that is precisely the case worth alerting on.
# ---------------------------------------------------------------------------
if [ "$projects_changed" -gt 0 ] && [ "$HEALTH_WAIT" -gt 0 ]; then
  log "waiting ${HEALTH_WAIT}s for containers to settle"
  sleep "$HEALTH_WAIT"
fi

running=$(docker ps -q 2>/dev/null | wc -l)
unhealthy=$(docker ps --filter health=unhealthy -q 2>/dev/null | wc -l)
restarting=$(docker ps --filter status=restarting -q 2>/dev/null | wc -l)

if [ "$restarting" -gt 0 ]; then
  log "ERROR $restarting container(s) restarting after update"
  failed=1
fi

# ---------------------------------------------------------------------------
# Reclaim space. `prune -f` removes DANGLING images only: layers no longer
# referenced by any tag, which after a pull means the images we just replaced.
#
# Never `prune -a`. That deletes any image with no RUNNING container, which
# includes the image of anything deliberately stopped, and turns a routine
# cleanup into a multi-gigabyte re-download the next time you start it.
# ---------------------------------------------------------------------------
reclaimed=0
if [ "$PRUNE" = "yes" ]; then
  reclaimed_raw=$(docker image prune -f 2>/dev/null | grep -oE 'Total reclaimed space: .*' || true)
  log "${reclaimed_raw:-Total reclaimed space: 0B}"
  # Report bytes so the metric is aggregatable; parse the human string back.
  reclaimed=$(echo "${reclaimed_raw#Total reclaimed space: }" | awk '
    /GB$/ {printf "%d", $0 * 1000000000; exit}
    /MB$/ {printf "%d", $0 * 1000000; exit}
    /kB$/ {printf "%d", $0 * 1000; exit}
    /B$/  {printf "%d", $0; exit}
    {print 0}')
fi
[ -n "$reclaimed" ] || reclaimed=0

finished=$(date +%s)

# ---------------------------------------------------------------------------
# Write metrics to a temp file and rename. The textfile collector will happily
# read a half-written file and export garbage otherwise; rename is atomic.
# ---------------------------------------------------------------------------
{
  echo "# HELP fleet_docker_update_last_run_timestamp_seconds When the container update last completed."
  echo "# TYPE fleet_docker_update_last_run_timestamp_seconds gauge"
  echo "fleet_docker_update_last_run_timestamp_seconds $finished"

  echo "# HELP fleet_docker_update_duration_seconds How long the last container update took."
  echo "# TYPE fleet_docker_update_duration_seconds gauge"
  echo "fleet_docker_update_duration_seconds $((finished - started))"

  echo "# HELP fleet_docker_update_failed 1 if the last container update hit an error."
  echo "# TYPE fleet_docker_update_failed gauge"
  echo "fleet_docker_update_failed $failed"

  echo "# HELP fleet_docker_compose_projects Compose projects running on this host."
  echo "# TYPE fleet_docker_compose_projects gauge"
  echo "fleet_docker_compose_projects $projects_seen"

  echo "# HELP fleet_docker_projects_updated Compose projects whose images changed in the last run."
  echo "# TYPE fleet_docker_projects_updated gauge"
  echo "fleet_docker_projects_updated $projects_changed"

  echo "# HELP fleet_docker_containers_recreated Containers moved onto a new image in the last run."
  echo "# TYPE fleet_docker_containers_recreated gauge"
  echo "fleet_docker_containers_recreated $containers_recreated"

  echo "# HELP fleet_docker_image_bytes_reclaimed Bytes freed by pruning dangling images."
  echo "# TYPE fleet_docker_image_bytes_reclaimed gauge"
  echo "fleet_docker_image_bytes_reclaimed $reclaimed"

  echo "# HELP fleet_docker_containers_running Containers running after the update."
  echo "# TYPE fleet_docker_containers_running gauge"
  echo "fleet_docker_containers_running $running"

  echo "# HELP fleet_docker_containers_unhealthy Containers reporting an unhealthy Docker healthcheck."
  echo "# TYPE fleet_docker_containers_unhealthy gauge"
  echo "fleet_docker_containers_unhealthy $unhealthy"

  echo "# HELP fleet_docker_containers_restarting Containers stuck restarting after the update."
  echo "# TYPE fleet_docker_containers_restarting gauge"
  echo "fleet_docker_containers_restarting $restarting"
} > "$TMP_FILE"

chmod 0644 "$TMP_FILE"
mv -f "$TMP_FILE" "$OUT_FILE"
trap - EXIT

log "done in $((finished - started))s: $projects_seen project(s), $projects_changed updated, $containers_recreated container(s) recreated, failed=$failed"
exit 0
