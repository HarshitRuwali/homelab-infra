# Managed by ansible/roles/network_history. Do not edit by hand.
# Datasources for the network history, separate from the shared datasources.yml.
# This file holds the reader password: root:grafana 0640.
apiVersion: 1

datasources:
  - name: Prometheus (network, 90 d)
    uid: prometheus-90d
    type: prometheus
    access: proxy
    url: http://{{ network_history_prometheus_listen }}
    isDefault: false
    editable: false
    jsonData:
      timeInterval: {{ network_history_scrape_interval }}
      queryTimeout: 60s

  # Read-only role. sslmode is disable: the database host is on the same private
  # LAN segment as this host and the connection never crosses the WAN.
  - name: Network history
    uid: net-history
    type: grafana-postgresql-datasource
    access: proxy
    url: {{ network_history_db_address }}:{{ network_history_db_port }}
    user: {{ network_history_db_reader }}
    isDefault: false
    editable: false
    jsonData:
      database: {{ network_history_db_name }}
      sslmode: disable
      postgresVersion: 1600
      maxOpenConns: 5
      maxIdleConns: 2
      connMaxLifetime: 14400
    secureJsonData:
      password: {{ network_history_reader_password | to_json }}
