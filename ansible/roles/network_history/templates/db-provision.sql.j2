-- Managed by ansible/roles/network_history. Do not edit by hand.
-- Run on the PostgreSQL host as the superuser through psql over the local socket:
--   docker exec -i {{ network_history_db_container }} psql -U {{ network_history_db_superuser }} -d {{ network_history_db_admin_database }} -v ON_ERROR_STOP=1 -X -f -
-- Idempotent: every statement is safe to repeat. It never connects to or alters
-- any other database. Passwords are applied with ALTER ROLE on every run.
\set ON_ERROR_STOP on

-- Roles: the writer owns schema net, the reader (Grafana, agents) can only SELECT.
SELECT NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{{ network_history_db_writer }}') AS need_writer \gset
\if :need_writer
CREATE ROLE {{ network_history_db_writer }} LOGIN;
\echo net_history: created role {{ network_history_db_writer }}
\endif
SELECT NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{{ network_history_db_reader }}') AS need_reader \gset
\if :need_reader
CREATE ROLE {{ network_history_db_reader }} LOGIN;
\echo net_history: created role {{ network_history_db_reader }}
\endif
ALTER ROLE {{ network_history_db_writer }} WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '{{ network_history_writer_password }}';
ALTER ROLE {{ network_history_db_reader }} WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '{{ network_history_reader_password }}';
ALTER ROLE {{ network_history_db_reader }} SET default_transaction_read_only = on;
ALTER ROLE {{ network_history_db_reader }} SET statement_timeout = '30s';
ALTER ROLE {{ network_history_db_reader }} SET search_path = net, pg_catalog;
ALTER ROLE {{ network_history_db_reader }} CONNECTION LIMIT 10;

-- The database: nobody but the two roles (and superusers) may connect.
SELECT NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = '{{ network_history_db_name }}') AS need_db \gset
\if :need_db
CREATE DATABASE {{ network_history_db_name }} OWNER {{ network_history_db_writer }};
\echo net_history: created database {{ network_history_db_name }}
\endif
REVOKE ALL ON DATABASE {{ network_history_db_name }} FROM PUBLIC;
GRANT CONNECT ON DATABASE {{ network_history_db_name }} TO {{ network_history_db_writer }}, {{ network_history_db_reader }};

-- Report only (nothing is changed): can the reader connect to another database
-- through PUBLIC's default CONNECT? It has no table or schema privileges there.
SELECT datname AS other_database,
       has_database_privilege('{{ network_history_db_reader }}', datname, 'CONNECT') AS reader_can_connect
FROM pg_database WHERE datallowconn AND datname NOT IN ('{{ network_history_db_name }}', 'template1');

-- Schema net, owned by the writer; the reader gets USAGE and SELECT, now and for
-- every table or view the writer creates later.
\connect {{ network_history_db_name }}
REVOKE ALL ON SCHEMA public FROM PUBLIC;
CREATE SCHEMA IF NOT EXISTS net AUTHORIZATION {{ network_history_db_writer }};
ALTER SCHEMA net OWNER TO {{ network_history_db_writer }};
GRANT USAGE ON SCHEMA net TO {{ network_history_db_reader }};
GRANT SELECT ON ALL TABLES IN SCHEMA net TO {{ network_history_db_reader }};
ALTER DEFAULT PRIVILEGES FOR ROLE {{ network_history_db_writer }} IN SCHEMA net GRANT SELECT ON TABLES TO {{ network_history_db_reader }};
