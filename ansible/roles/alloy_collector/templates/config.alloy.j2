// Managed by ansible/roles/alloy_collector. Do not edit by hand.
// Rendered for {{ inventory_hostname }} (role={{ monitor_role }}).
//
// This template is the single source of truth for every NATIVE Alloy install
// in the fleet. Two other copies of this config exist and are deliberately
// scoped narrower:
//   - alloy/config.alloy            -> Docker collector only (sets rootfs_path
//                                      etc. because it runs with bind mounts)
//   - scripts/lxc-install.sh heredoc -> bootstrap only, guarded by
//                                      /etc/alloy/.ansible-managed
// A native install must NOT set rootfs_path/procfs_path/sysfs_path.

logging {
  level  = "info"
  format = "logfmt"
}

prometheus.remote_write "central" {
  external_labels = {
    host = sys.env("MONITOR_HOSTNAME"),
    role = sys.env("MONITOR_ROLE"),
  }

  endpoint {
    name = "central-prometheus"
    url  = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
{% if collector_basic_auth_required | bool %}

    basic_auth {
      username = sys.env("COLLECTOR_BASIC_AUTH_USER")
      password = sys.env("COLLECTOR_BASIC_AUTH_PASSWORD")
    }
{% endif %}
{% if collector_ingest_ca_file | trim | length > 0 %}

    // Private HTTPS ingest: trust only the homelab CA that signed it.
    tls_config {
      ca_file = "{{ alloy_ingest_ca_path }}"
    }
{% endif %}

    // Onboarding the whole fleet at once means backfilling a lot of history
    // through a shared ingest path. Retry rather than drop on backpressure.
    queue_config {
      capacity            = 10000
      max_shards          = 10
      batch_send_deadline = "5s"
      retry_on_http_429   = true
    }
  }
}

prometheus.exporter.unix "host" {
  enable_collectors = ["systemd", "processes"]

  // Reads /var/lib/node_exporter/textfile_collector/*.prom, which is how the
  // update_metrics role surfaces apt/reboot state. node_exporter also emits
  // node_textfile_mtime_seconds for free, so a broken exporter script is
  // detectable centrally.
  textfile {
    directory = "{{ alloy_textfile_dir }}"
  }

  filesystem {
    mount_points_exclude = "{{ alloy_fs_mount_points_exclude }}"
    fs_types_exclude     = "{{ alloy_fs_types_exclude }}"
  }

  systemd {
    enable_restarts = true
    start_time      = true
    task_metrics    = true
    unit_exclude    = "{{ alloy_systemd_unit_exclude }}"
  }
}

prometheus.scrape "host" {
  job_name        = "host-unix"
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.central.receiver]
}

prometheus.scrape "alloy" {
  job_name   = "alloy"
  targets    = [{"__address__" = "{{ alloy_listen_addr }}"}]
  forward_to = [prometheus.relabel.alloy_host.receiver]
}

// Alloy's own loki_write_* metrics use `host` for the destination URL.
// External labels only fill absent labels, so collectors with the same role
// otherwise send identical series and Prometheus rejects out-of-order writes.
prometheus.relabel "alloy_host" {
  forward_to = [prometheus.remote_write.central.receiver]

  // Keep the write destination before overwriting `host`, so the loki_write_*
  // metrics still show which ingest URL each collector is using.
  rule {
    source_labels = ["host"]
    regex         = "(.+)"
    target_label  = "destination_host"
  }

  rule {
    target_label = "host"
    replacement  = sys.env("MONITOR_HOSTNAME")
  }
}

loki.write "central" {
  external_labels = {
    host = sys.env("MONITOR_HOSTNAME"),
    role = sys.env("MONITOR_ROLE"),
  }

  endpoint {
    name = "central-loki"
    url  = sys.env("LOKI_WRITE_URL")
{% if collector_basic_auth_required | bool %}

    basic_auth {
      username = sys.env("COLLECTOR_BASIC_AUTH_USER")
      password = sys.env("COLLECTOR_BASIC_AUTH_PASSWORD")
    }
{% endif %}
{% if collector_ingest_ca_file | trim | length > 0 %}

    // Private HTTPS ingest: trust only the homelab CA that signed it.
    tls_config {
      ca_file = "{{ alloy_ingest_ca_path }}"
    }
{% endif %}
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "system" {
  max_age       = "{{ alloy_journal_max_age }}"
  labels        = {job = "systemd-journal", source = "journal"}
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.central.receiver]
}
{% if alloy_enable_process | default(false) %}

// --- Per-process metrics -------------------------------------------------
// Opt-in per host; see alloy_enable_process in the role defaults for the
// cardinality reasoning.

prometheus.exporter.process "processes" {
  // Group by command name, so every PID of the same program collapses into
  // one series. Grouping by PID instead mints a new series on every restart
  // and grows without bound.
  //
  // The matcher name is hardcoded rather than exposed as a variable on
  // purpose: its value is the literal string {{ "{{.Comm}}" }}, and Ansible
  // templates variable values too, so holding it in a var means fighting two
  // layers of Jinja to keep the braces intact. It is not worth a knob.
  // `cmdline`, not `comm`. They are not interchangeable: comm is a list of
  // EXACT command names, cmdline is a list of REGEXES. `comm = [".+"]` is
  // therefore not "match everything", it matches a process literally named
  // ".+", which is nothing at all. Verified the wrong way round first: the
  // component started cleanly, the scrape pool came up, and exactly zero
  // series were produced.
  matcher {
    name    = "{{ "{{.Comm}}" }}"
    cmdline = [".+"]
  }

  // Both off deliberately. track_threads multiplies series by thread count,
  // and gather_smaps walks /proc/*/smaps on every scrape, which is expensive
  // on a host with many processes and buys detail nothing here charts.
  track_threads = false
  gather_smaps  = false
}

prometheus.scrape "processes" {
  job_name        = "host-process"
  targets         = prometheus.exporter.process.processes.targets
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.central.receiver]
}
{% endif %}
{% if gpu_exporter_available | default(false) %}

// --- GPU telemetry (host has an NVIDIA GPU) -------------------------------
// nvidia_gpu_exporter runs as its own systemd service, installed and bound
// to loopback by roles/gpu_exporter; there is no in-process Alloy component
// for this the way prometheus.exporter.unix/.cadvisor are.

prometheus.scrape "gpu" {
  job_name        = "nvidia-gpu"
  targets         = [{"__address__" = "{{ gpu_exporter_listen_addr }}"}]
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.central.receiver]
}
{% endif %}
{% if alloy_docker_effective %}

// --- Docker telemetry (host has /var/run/docker.sock) --------------------

prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "5m"
}

prometheus.scrape "containers" {
  job_name        = "container-cadvisor"
  targets         = prometheus.exporter.cadvisor.containers.targets
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.central.receiver]
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    target_label = "source"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  labels     = {job = "docker"}
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.write.central.receiver]
}
{% endif %}

{% if alloy_syslog_listener_port | default('') | string | length > 0 %}

// --- Syslog from devices that cannot run Alloy ---------------------------
// The firewall is FreeBSD and outside Ansible's reach, so what it knows
// arrives as syslog instead of being scraped: Suricata's EVE alerts, its
// filter log, the resolver's query log and a per-minute pfstats line. Only
// the host with alloy_syslog_listener_port set opens this; see
// group_vars/central and security/docs/wiring/index.md.
//
// host and role are set here, not left to loki.write. Its external_labels
// stamp every stream with THIS host's identity, so without them the
// firewall's alerts were stored as host="main-server", role="central", as if
// the monitoring box had raised them. Labels on the stream take precedence
// over external_labels, which is what makes this override work.
loki.relabel "firewall_syslog" {
  // The syslog program name becomes `job`, for the four programs the firewall
  // runs. Suricata keeps job="suricata", the value every dashboard and rule
  // already selects; the others (filterlog, unbound, pfstats) get their own
  // job instead of being stored as Suricata.
  //
  // Only those four. The listener cannot tell who is connecting and the
  // program name is whatever the sender writes, so copying it unchecked would
  // let anyone who can reach the port create streams without limit. Any other
  // name leaves the listener's static job="firewall-other" in place. The
  // allowed names bound the number of streams; they do not prove who sent a
  // line.
  rule {
    source_labels = ["__syslog_message_app_name"]
    regex         = "^(suricata|filterlog|unbound|pfstats)$"
    target_label  = "job"
    replacement   = "$1"
  }

  forward_to = []
}

loki.source.syslog "firewall" {
  listener {
    address  = "0.0.0.0:{{ alloy_syslog_listener_port }}"
    protocol = "tcp"
    labels   = {job = "firewall-other", source = "opnsense", host = "opnsense", role = "firewall"}
  }

  relabel_rules = loki.relabel.firewall_syslog.rules
  forward_to    = [loki.process.firewall_syslog.receiver]
}

loki.process "firewall_syslog" {
  // filterlog is CSV: rule,sub,anchor,label,INTERFACE,reason,ACTION,dir,...
  // Interface and action become labels so a query can select one segment's
  // passes or blocks without scanning the rest. This comes FIRST: the drop
  // below selects on iface, and a stage can only select on a label an earlier
  // stage has set.
  //
  // Each field is only taken when it is a value the firewall can write. The
  // listener cannot tell who is connecting, and a label built from whatever a
  // sender puts in the line would let anyone who can reach the port mint
  // streams without limit. A line whose field is anything else is still
  // stored, with no such label. One stage per field, so a bad interface does
  // not cost the line its action. The allowed interfaces are vtnet0 to vtnet99,
  // lo0, enc0, pflog0, igb0 to igb99 and em0 to em99; the allowed actions are
  // pass, block, match, rdr, nat, binat, scrub, rdr-anchor and nat-anchor.
  stage.match {
    selector = `{job="filterlog"}`

    stage.regex {
      expression = `^[^,]*,[^,]*,[^,]*,[^,]*,(?P<iface>vtnet[0-9]{1,2}|lo0|enc0|pflog0|igb[0-9]{1,2}|em[0-9]{1,2}),`
    }

    stage.regex {
      expression = `^[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,(?P<action>pass|block|match|rdr|nat|binat|scrub|rdr-anchor|nat-anchor),`
    }

    stage.labels {
      values = {iface = "", action = ""}
    }
  }

{% if alloy_syslog_drop_filterlog_rules | default([]) | length > 0 %}
  // filterlog lines that carry no decision worth keeping, matched by the rule
  // label in field 4 (see group_vars/central for what each one is), and only
  // on the interface named in alloy_syslog_drop_filterlog_iface. A rule label
  // does not name an interface, and the rule listed there is OPNsense's default
  // deny, which every interface can fire: dropped everywhere it would hide
  // what it catches on every other segment.
  stage.match {
    selector = `{job="filterlog", iface="{{ alloy_syslog_drop_filterlog_iface }}"} |~ ",({{ alloy_syslog_drop_filterlog_rules | join('|') }}),"`
    action   = "drop"
  }

{% endif %}
{% if alloy_syslog_ratelimit_filterlog_rules | default([]) | length > 0 %}
  // A source banned for exceeding a connection limit keeps retrying, and the
  // firewall logs every blocked packet: hundreds of lines a second. Keep the
  // first few of each second and drop the rest; the OPNsense log has them all.
  stage.match {
    selector = `{job="filterlog"} |~ ",({{ alloy_syslog_ratelimit_filterlog_rules | join('|') }}),"`

    stage.limit {
      rate  = 5
      burst = 20
      drop  = true
    }
  }

{% endif %}
  forward_to = [loki.write.central.receiver]
}
{% endif %}

{% if alloy_pve_firewall_log | default(false) | bool %}

// --- Proxmox firewall log --------------------------------------------------
// The datacenter firewall's rules carry a log level, and pvefw-logger writes
// what they drop to this file, one line per event, rate-limited by iptables to
// one a second per rule. The line starts with "<vmid-ish> <level> <chain> <time>"
// and carries IN=, OUT=, PHYSIN=tapNNNi0, SRC=, DST=, PROTO=, DPT=. `chain`
// (which rule fired) and `vmid` (which guest) become labels; everything else is
// read at query time with | logfmt or | regexp. The timestamp comes from the
// line, so a backlog after a restart lands at the right time.
local.file_match "pve_firewall" {
  path_targets = [{"__path__" = "/var/log/pve-firewall.log", job = "pve-firewall"}]
}

loki.source.file "pve_firewall" {
  targets    = local.file_match.pve_firewall.targets
  forward_to = [loki.process.pve_firewall.receiver]
}

loki.process "pve_firewall" {
  stage.regex {
    expression = `^\d+ \d+ (?P<chain>\S+) (?P<ts>\d{2}/\w{3}/\d{4}:\d{2}:\d{2}:\d{2} [+-]\d{4}) `
  }

  stage.timestamp {
    source = "ts"
    format = "02/Jan/2006:15:04:05 -0700"
  }

  stage.regex {
    expression = `PHYS(?:IN|OUT)=tap(?P<vmid>\d+)i\d+`
  }

  stage.labels {
    values = {chain = "", vmid = ""}
  }

  forward_to = [loki.write.central.receiver]
}
{% endif %}

{% if inventory_hostname in groups['wazuh_manager'] | default([]) %}

// --- Wazuh alerts --------------------------------------------------------
// Every alert the manager raises, for every agent, as one JSON object per
// line. Tailing the file keeps Grafana the single pane and leaves the Wazuh
// dashboard for deep investigation. Wazuh rotates it daily into
// logs/alerts/YYYY/Mon/, and loki.source.file follows the path, not the inode.
//
// host stays the manager's (from loki.write), because the alert is the
// manager's verdict. The host an alert is ABOUT is `agent.name` inside the
// line: `| json` gives it as agent_name. Not promoted to a label on purpose,
// so a fleet-wide rollout does not multiply streams.
local.file_match "wazuh_alerts" {
  path_targets = [{"__path__" = "/var/ossec/logs/alerts/alerts.json", job = "wazuh"}]
}

loki.source.file "wazuh_alerts" {
  targets    = local.file_match.wazuh_alerts.targets
  forward_to = [loki.write.central.receiver]
}
{% endif %}
