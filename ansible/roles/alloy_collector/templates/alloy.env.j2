# Managed by ansible/roles/alloy_collector. Do not edit by hand.
# systemd EnvironmentFile for the alloy unit; consumed via sys.env() in config.alloy.
CONFIG_FILE="{{ alloy_config_path }}"
CUSTOM_ARGS="--server.http.listen-addr={{ alloy_listen_addr }}"
MONITOR_HOSTNAME="{{ monitor_hostname }}"
MONITOR_ROLE="{{ monitor_role }}"
PROMETHEUS_REMOTE_WRITE_URL="{{ prometheus_remote_write_url }}"
LOKI_WRITE_URL="{{ loki_write_url }}"
{% if collector_basic_auth_required | bool %}
COLLECTOR_BASIC_AUTH_USER="{{ collector_basic_auth_user }}"
COLLECTOR_BASIC_AUTH_PASSWORD="{{ collector_basic_auth_password }}"
{% endif %}
