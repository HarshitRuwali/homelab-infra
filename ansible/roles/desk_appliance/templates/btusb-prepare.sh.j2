#!/bin/bash
# Managed by ansible/roles/desk_appliance. Do not edit by hand.
#
# DKMS PRE_BUILD script of desk-appliance-btusb. DKMS copies the module's
# sources (this script, dkms.conf, btusb-quirks.list) into a build directory and
# runs it there, before `make`, as `btusb-prepare.sh <kernelver>`. It copies the
# distribution's own drivers/bluetooth source for that kernel into the build
# directory, adds each USB id in btusb-quirks.list to btusb's quirks table
# (where btusb looks up the vendor setup, BTUSB_MEDIATEK and so on, for a device
# its generic class match already binds), and compiles the result.
#
# The source comes from the linux-source package whose version is exactly the
# version of the package that ships this kernel's in-tree btusb.ko, so the
# result is the in-tree btusb.c plus the listed ids and nothing else.
#
# Every way this script can fail ends in exit 77, which DKMS records as
# skipped, not failed, so the in-tree btusb stays in use and a kernel package's
# postinst is not failed by this module. The ERR trap below turns any failure
# not handled explicitly into the same exit. The explicit ones: no matching
# linux-source or headers,
# a tarball that does not extract, a source that already has every listed id
# (the kernel has caught up; empty the list), a malformed list, and a compile
# error. The compile runs here for that reason; DKMS's own `make` afterwards
# finds everything built. Anything else DKMS itself does (copying the sources,
# installing the built module) is outside this script.
#
# This file is plain bash, not a Jinja template, so the tests can run it as is.
# Tests only: DESK_BTUSB_SOURCE_TARBALL names a source tarball directly,
# DESK_BTUSB_MODULES_DIR replaces /lib/modules for the dpkg lookup, and
# DESK_BTUSB_KERNEL_BUILD_DIR replaces /lib/modules/<kernelver>/build.
set -Eeuo pipefail

kernelver=${1:-}
build=$(pwd)
quirks_list="$build/btusb-quirks.list"
kbuild_dir=${DESK_BTUSB_KERNEL_BUILD_DIR:-/lib/modules/$kernelver/build}
# Anchored, so a mention in a comment is not taken for the table itself.
# Passed to awk through the environment: `awk -v` would turn `\[` into `[`.
export TABLE_RE='^static const struct usb_device_id quirks_table\[\] = \{$'

skip() {
  echo "desk-appliance-btusb: not building for ${kernelver:-?}: $*" >&2
  exit 77
}
trap 'skip "unexpected failure (exit $?) at line $LINENO of $0"' ERR

[ -n "$kernelver" ] || skip "usage: btusb-prepare.sh <kernelver>"

# The linux-source tarball at the exact version of this kernel's in-tree btusb.
find_tarball() {
  local module owner version package
  module=$(find "${DESK_BTUSB_MODULES_DIR:-/lib/modules}/$kernelver/kernel/drivers/bluetooth" \
    -name 'btusb.ko*' -print -quit 2>/dev/null || true)
  [ -n "$module" ] || return 1
  # With merged /usr, /lib is a symlink and dpkg may record the module under
  # /usr/lib/modules only, so the resolved path is the fallback.
  owner=$({ dpkg-query -S "$module" 2>/dev/null ||
    dpkg-query -S "$(readlink -f "$module")" 2>/dev/null || true; } |
    head -n1 | cut -d: -f1)
  [ -n "$owner" ] || return 1
  version=$(dpkg-query -W -f '${Version}' "$owner" 2>/dev/null)
  [ -n "$version" ] || return 1
  # `iU` (unpacked, not yet configured) counts: during an apt run that brings
  # the kernel and linux-source together, the tarball is on disk by then.
  package=$(dpkg-query -W -f '${Package}\t${Version}\t${db:Status-Abbrev}\n' \
    'linux-source-*' 2>/dev/null |
    awk -F'\t' -v v="$version" '$2 == v && $3 ~ /^i[iU]/ { print $1; exit }')
  [ -n "$package" ] || return 1
  dpkg-query -L "$package" | grep -E '/linux-source-[^/]+\.tar\.(xz|bz2|gz)$' | head -n1
}

[ -r "$quirks_list" ] || skip "$quirks_list is missing"
[ -d "$kbuild_dir/include" ] || skip "no kernel headers at $kbuild_dir"

tarball=${DESK_BTUSB_SOURCE_TARBALL:-$(find_tarball || true)}
[ -n "$tarball" ] && [ -r "$tarball" ] ||
  skip "no installed linux-source package matches the package of its in-tree btusb.ko"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# One xz thread at low priority: this runs on a box with a latency-sensitive
# workload, and the whole archive is decompressed to reach one directory.
XZ_DEFAULTS=-T1 nice -n 19 tar -xf "$tarball" -C "$work" \
  --wildcards '*/drivers/bluetooth/*' 2>"$work/tar.err" ||
  skip "cannot extract drivers/bluetooth from $tarball: $(head -n1 "$work/tar.err")"
# The tarball has one top-level directory (linux-source-<version>/).
src=
for dir in "$work"/*/drivers/bluetooth; do
  [ -z "$src" ] || skip "$tarball has more than one drivers/bluetooth"
  [ -d "$dir" ] && src=$dir
done
[ -n "$src" ] && [ -f "$src/Makefile" ] || skip "$tarball has no drivers/bluetooth"

find "$src" -maxdepth 1 -type f \( -name '*.c' -o -name '*.h' \) \
  -exec cp -t "$build" {} + || skip "cannot copy the sources from $tarball"

# btusb is one file up to 7.2 and several from 7.3 (btusb_main.c and friends);
# the upstream Makefile's btusb-* lines say which, so they are copied, with any
# backslash-continued line joined first.
{
  echo "# Generated by btusb-prepare.sh from $(basename "$tarball")"
  echo "obj-m := btusb.o"
  awk '{ while (/\\$/ && (getline more) > 0) { sub(/\\$/, ""); $0 = $0 more } print }' \
    "$src/Makefile" | grep -E '^btusb-' || true
} >"$build/Kbuild"

target=$(grep -l -E "$TABLE_RE" "$build"/btusb*.c 2>/dev/null || true)
[ "$(printf '%s\n' "$target" | grep -c .)" = 1 ] ||
  skip "expected one btusb source file with quirks_table, found: ${target:-none}"
[ "$(grep -c -E "$TABLE_RE" "$target")" = 1 ] ||
  skip "$(basename "$target") defines quirks_table more than once"

# quirks_table only, so an id that is merely in the generic btusb_table still
# counts as missing. Read once: `awk | grep -q` under pipefail can report a
# match as missing when grep exits first and awk takes SIGPIPE.
quirks_region=$(awk '$0 ~ ENVIRON["TABLE_RE"] { on = 1 } on { print } on && /^};/ { exit }' "$target")

added=0
seen=" "
insert="$work/insert"
: >"$insert"
while read -r vendor product flags; do
  case "$vendor" in '' | '#'*) continue ;; esac
  [[ $vendor =~ ^[0-9a-f]{4}$ && $product =~ ^[0-9a-f]{4}$ ]] ||
    skip "malformed line in $quirks_list: $vendor $product $flags"
  [[ $flags =~ ^BTUSB_[A-Z0-9_]+(\ \|\ BTUSB_[A-Z0-9_]+)*$ ]] ||
    skip "malformed driver_info for $vendor:$product: $flags"
  case "$seen" in *" $vendor:$product "*)
    echo "desk-appliance-btusb: $vendor:$product is listed twice; adding it once"
    continue ;;
  esac
  seen="$seen$vendor:$product "
  if grep -qiE "USB_DEVICE\(0x$vendor, *0x$product\)" <<<"$quirks_region"; then
    echo "desk-appliance-btusb: $vendor:$product is already in quirks_table"
    continue
  fi
  printf '\t{ USB_DEVICE(0x%s, 0x%s), .driver_info = %s },\n' \
    "$vendor" "$product" "$flags" >>"$insert"
  echo "desk-appliance-btusb: adding $vendor:$product ($flags)"
  added=$((added + 1))
done <"$quirks_list"

[ "$added" -gt 0 ] ||
  skip "its btusb already has every id in $quirks_list; empty desk_appliance_btusb_quirks"

awk -v insert="$insert" '
  { print }
  $0 ~ ENVIRON["TABLE_RE"] {
    print "\t/* Added by desk_appliance (btusb-quirks.list) */"
    while ((getline line < insert) > 0) print line
  }' "$target" >"$work/patched"
cat "$work/patched" >"$target"

echo "desk-appliance-btusb: $added id(s) added to $(basename "$target") for $kernelver"

nice -n 19 make -C "$kbuild_dir" M="$build" KERNELRELEASE="$kernelver" modules ||
  skip "btusb with the added ids did not compile (the compiler output is above)"
