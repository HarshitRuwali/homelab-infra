# Managed by ansible/roles/desk_appliance. Do not edit by hand.
#
# An appliance has no lid worth honouring and nobody at the keyboard to wake
# it. The sleep targets are also masked (see tasks/power.yml).
[Login]
HandleLidSwitch=ignore
HandleLidSwitchExternalPower=ignore
HandleLidSwitchDocked=ignore
HandleSuspendKey=ignore
HandleHibernateKey=ignore
IdleAction=ignore
