# FastAPI service - environment variables
# Copy to .env and fill in values before running docker compose.

POSTGRES_USER=open_memory
POSTGRES_PASSWORD=
POSTGRES_DB=open_memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=memory
VECTOR_DIM=768

REDIS_HOST=localhost
REDIS_PORT=6379

AI_VM_HOST=localhost
LLM_PORT=8080
EMBED_PORT=8081

APP_HOST=0.0.0.0
APP_PORT=8080
FASTAPI_PORT=8080
UVICORN_WORKERS=2
LOG_LEVEL=info
