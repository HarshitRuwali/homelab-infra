#!/usr/bin/env bash
#
# s3-backup-discover - inspect the running Immich/Nextcloud containers and
# print a filled-in backup.env draft. Read-only: touches nothing.
#
#   sudo ./s3-backup-discover > /etc/s3-backup/backup.env
#
set -euo pipefail

command -v docker >/dev/null || { echo "docker not found" >&2; exit 1; }

say() { printf '%s\n' "$*"; }
note() { printf '# >> %s\n' "$*"; }

find_container() {
  local pattern="$1"
  docker ps --format '{{.Names}}\t{{.Image}}' \
    | awk -v p="$pattern" 'tolower($0) ~ p {print $1}' | head -1
}

mount_source_for() {
  local container="$1"; shift
  local dest
  for dest in "$@"; do
    docker inspect -f "{{range .Mounts}}{{if eq .Destination \"$dest\"}}{{.Source}}{{end}}{{end}}" \
      "$container" 2>/dev/null | grep -v '^$' && return 0
  done
  return 0
}

db_engine_for() {
  local image
  image="$(docker inspect -f '{{.Config.Image}}' "$1" 2>/dev/null || true)"
  case "${image,,}" in
    *postgres*|*pgvector*) echo postgres ;;
    *mysql*|*mariadb*)     echo mysql ;;
    *)                     echo UNKNOWN ;;
  esac
}

IMMICH_SERVER="$(find_container 'immich.*server|immich_server')"
IMMICH_DB="$(find_container 'immich.*(postgres|pgvector|database)')"
NC_APP="$(find_container 'nextcloud')"
NC_DB="$(find_container 'nextcloud.*(db|mysql|maria|postgres)|(mysql|maria).*nextcloud')"

IMMICH_UPLOAD="$(mount_source_for "${IMMICH_SERVER:-none}" /usr/src/app/upload /data /photos 2>/dev/null || true)"
NC_DATA="$(mount_source_for "${NC_APP:-none}" /var/www/html/data 2>/dev/null || true)"
NC_CONFIG="$(mount_source_for "${NC_APP:-none}" /var/www/html/config 2>/dev/null || true)"
NC_ROOT="$(mount_source_for "${NC_APP:-none}" /var/www/html 2>/dev/null || true)"
[[ -z "$NC_DATA"   && -n "$NC_ROOT" ]] && NC_DATA="${NC_ROOT%/}/data"
[[ -z "$NC_CONFIG" && -n "$NC_ROOT" ]] && NC_CONFIG="${NC_ROOT%/}/config"

HDD_MP=""
if [[ -n "$IMMICH_UPLOAD" || -n "$NC_DATA" ]]; then
  probe="${IMMICH_UPLOAD:-$NC_DATA}"
  HDD_MP="$(df -P "$probe" 2>/dev/null | awk 'NR==2 {print $6}')"
fi

say "# Generated by s3-backup-discover on $(date -Is) on $(hostname -s)."
say "# Review every line marked >> before using this file."
say ""
[[ -z "$IMMICH_SERVER" ]] && note "Could not find an Immich server container. Set IMMICH_* by hand."
[[ -z "$NC_APP"        ]] && note "Could not find a Nextcloud container. Set NEXTCLOUD_* by hand."
say ""
note "Left blank on purpose: s3-backup-setup-aws fills all of these in."
say 'S3_BUCKET=""'
say 'AWS_DEFAULT_REGION=""'
say 'S3_ENDPOINT=""'
say 'S3_PROVIDER="AWS"'
say ""
say 'SECRETS_BACKEND="aws-secrets-manager"'
say 'SECRET_ID=""'
say 'SECRET_REGION=""'
say 'BOOTSTRAP_AWS_ACCESS_KEY_ID=""'
say 'BOOTSTRAP_AWS_SECRET_ACCESS_KEY=""'
say 'BOOTSTRAP_AWS_PROFILE=""'
say 'AWS_ACCESS_KEY_ID=""'
say 'AWS_SECRET_ACCESS_KEY=""'
say 'RUNTIME_SECRET_DIR="/run/s3-backup"'
say 'AWSCLI_IMAGE="amazon/aws-cli:2.17.0"'
say ""
say "IMMICH_ENABLED=$([[ -n "$IMMICH_SERVER" ]] && echo 1 || echo 0)"
say "IMMICH_DB_CONTAINER=\"${IMMICH_DB:-immich_postgres}\""
say "IMMICH_UPLOAD_LOCATION=\"${IMMICH_UPLOAD:-/mnt/hdd/immich}\""
say 'IMMICH_SYNC_DIRS="library profile upload backups"'
say 'IMMICH_PREFIX="immich"'
say 'IMMICH_S3_STORAGE_CLASS="GLACIER_IR"'
say ""
say "NEXTCLOUD_ENABLED=$([[ -n "$NC_APP" ]] && echo 1 || echo 0)"
say "NEXTCLOUD_APP_CONTAINER=\"${NC_APP:-nextcloud}\""
say "NEXTCLOUD_DB_CONTAINER=\"${NC_DB:-nextcloud-db}\""
say "NEXTCLOUD_DB_ENGINE=\"$(db_engine_for "${NC_DB:-none}")\""
say "NEXTCLOUD_DATA_DIR=\"${NC_DATA:-/mnt/hdd/nextcloud/data}\""
say "NEXTCLOUD_CONFIG_DIR=\"${NC_CONFIG:-/mnt/hdd/nextcloud/config}\""
say 'NEXTCLOUD_OCC_USER="www-data"'
say 'NEXTCLOUD_OCC_PATH="occ"'
say 'NEXTCLOUD_MAINTENANCE_MODE="dumps_only"'
say 'NEXTCLOUD_EXCLUDE_PREVIEWS=1'
say ""
say "HDD_MOUNTPOINT=\"${HDD_MP:-/mnt/hdd}\""
say 'CANARY_FILE=".s3-backup-canary"'
say 'RCLONE_MAX_DELETE=1000'
say 'MIN_STAGING_FREE_MB=5120'
say ""
say 'RESTIC_PREFIX="restic"'
say 'RESTIC_CACHE_DIR="/var/cache/restic"'
say 'RESTIC_KEEP_DAILY=7'
say 'RESTIC_KEEP_WEEKLY=4'
say 'RESTIC_KEEP_MONTHLY=6'
say 'RESTIC_KEEP_YEARLY=1'
say 'RESTIC_PRUNE_DAY=7'
say ""
say 'STAGING_DIR="/var/lib/s3-backup/staging"'
say 'STAGING_KEEP=2'
say 'RUNNER_IMAGE="s3-backup-runner:1.0.0"'
say 'LOCK_FILE="/var/lock/s3-backup.lock"'
say 'RCLONE_TRANSFERS=8'
say 'RCLONE_CHECKERS=16'
say 'RCLONE_BWLIMIT=""'
say ""
say 'METRICS_DIR="/var/lib/node_exporter/textfile_collector"'
say 'HEALTHCHECK_URL=""'

{
  echo ""
  echo "# ---- what discover actually saw ----"
  echo "# immich server container : ${IMMICH_SERVER:-NOT FOUND}"
  echo "# immich db container     : ${IMMICH_DB:-NOT FOUND}"
  echo "# nextcloud app container : ${NC_APP:-NOT FOUND}"
  echo "# nextcloud db container  : ${NC_DB:-NOT FOUND} (engine: $(db_engine_for "${NC_DB:-none}"))"
  echo "# detected HDD mount      : ${HDD_MP:-UNKNOWN}"
  for p in "$IMMICH_UPLOAD" "$NC_DATA"; do
    [[ -n "$p" && -d "$p" ]] && echo "# size of $p : $(du -sh "$p" 2>/dev/null | cut -f1)"
  done
}
