[Unit]
Description=AI box model queue (serializes inference across one GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MODEL_PROXY_UPSTREAM=__UPSTREAM__
Environment=MODEL_PROXY_HOST=__HOST__
Environment=MODEL_PROXY_PORT=__PORT__
# Optional secrets and overrides (for example MODEL_PROXY_TOKEN=...). The leading dash
# makes the file optional. Keep it mode 600; it is not part of this repository.
EnvironmentFile=-%h/.config/hermes-model-queue.env
ExecStart=__PYTHON__ __INSTALL_DIR__/proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
