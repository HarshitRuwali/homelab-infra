[Unit]
Description=AI box model queue (serializes inference across one GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MODEL_PROXY_UPSTREAM=__UPSTREAM__
Environment=MODEL_PROXY_HOST=127.0.0.1
Environment=MODEL_PROXY_PORT=8099
ExecStart=__PYTHON__ __HERE__/proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
