# =============================================================================
# s3-backup-automation configuration
#
# Deployed to /etc/s3-backup/backup.env  (root-owned, chmod 0600)
# Run `s3-backup-discover` on the server to generate a filled-in draft.
#
# NOTE: There are deliberately NO database passwords in this file. Dumps run
# inside the Immich/Nextcloud DB containers and read those containers' own
# POSTGRES_PASSWORD / MYSQL_ROOT_PASSWORD env vars. See docs/architecture.md.
#
# With SECRETS_BACKEND=aws-secrets-manager the only credential here is the
# bootstrap key, which can do nothing but read one secret.
# =============================================================================

# --- S3 target ---------------------------------------------------------------
S3_BUCKET="my-homelab-backup"
AWS_DEFAULT_REGION="ap-south-1"

# Set for S3-compatible providers (B2 / Wasabi / R2 / MinIO). Leave empty for AWS.
S3_ENDPOINT=""
# rclone provider name: AWS, Wasabi, Cloudflare, Minio, Other
S3_PROVIDER="AWS"

# --- Secrets -----------------------------------------------------------------
#   file                -> the restic password and S3 keys live on this host.
#   aws-secrets-manager -> they are fetched from Secrets Manager at run time and
#                          written to a tmpfs for the duration of the run.
SECRETS_BACKEND="aws-secrets-manager"

# -- SECRETS_BACKEND=file only -------------------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
RESTIC_PASSWORD_FILE="/etc/s3-backup/restic-password"

# -- SECRETS_BACKEND=aws-secrets-manager only ----------------------------------
# The secret. Either a plain string (taken to be the restic password) or a JSON
# object with the field names below. Create it with aws/secret-setup.sh.
SECRET_ID="homelab/s3-backup"
# Region holding the secret; defaults to AWS_DEFAULT_REGION.
SECRET_REGION=""
SECRET_KEY_RESTIC_PASSWORD="restic_password"
SECRET_KEY_AWS_ACCESS_KEY_ID="aws_access_key_id"
SECRET_KEY_AWS_SECRET_ACCESS_KEY="aws_secret_access_key"

# Bootstrap credentials. Reading a secret still requires *some* credential, so
# this one cannot itself be fetched. Scope it to secretsmanager:GetSecretValue
# on the single ARN above and nothing else - aws/secret-setup.sh does that.
#
# Either an access key pair...
BOOTSTRAP_AWS_ACCESS_KEY_ID=""
BOOTSTRAP_AWS_SECRET_ACCESS_KEY=""
# ...or a profile in /root/.aws, which is how you would plug in IAM Roles
# Anywhere or any other credential_process and keep no long-lived key at all.
BOOTSTRAP_AWS_PROFILE=""
BOOTSTRAP_AWS_DIR="/root/.aws"

# Where the fetched password is written for the life of the run. Must be tmpfs
# so it never reaches the disk; /run is tmpfs on any systemd host.
RUNTIME_SECRET_DIR="/run/s3-backup"

# Pinned AWS CLI image, used only to read the secret and for bucket setup.
AWSCLI_IMAGE="amazon/aws-cli:2.17.0"

# --- restic (databases + Nextcloud) ------------------------------------------
# Prefix inside the bucket that holds the restic repository.
RESTIC_PREFIX="restic"
RESTIC_CACHE_DIR="/var/cache/restic"

# Retention. `forget` runs every night; the expensive `prune` only on PRUNE_DAY.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
RESTIC_KEEP_YEARLY=1
# Day-of-week (1=Mon .. 7=Sun) to run prune + integrity check. Empty disables.
RESTIC_PRUNE_DAY=7

# --- Immich ------------------------------------------------------------------
IMMICH_ENABLED=1
IMMICH_DB_CONTAINER="immich_postgres"
# Immich's UPLOAD_LOCATION on the HDD (the dir containing library/, upload/, ...)
IMMICH_UPLOAD_LOCATION="/mnt/hdd/immich"
# Subdirectories of UPLOAD_LOCATION mirrored to S3. thumbs/ and encoded-video/
# are intentionally excluded: Immich regenerates them, and they are large.
IMMICH_SYNC_DIRS="library profile upload backups"
# Prefix inside the bucket for the Immich mirror.
IMMICH_PREFIX="immich"
# GLACIER_IR is ~5x cheaper than STANDARD with instant retrieval, and Immich
# originals are write-once so the 90-day minimum never bites. See docs/costs.md.
IMMICH_S3_STORAGE_CLASS="GLACIER_IR"

# --- Nextcloud ---------------------------------------------------------------
NEXTCLOUD_ENABLED=1
NEXTCLOUD_APP_CONTAINER="nextcloud"
NEXTCLOUD_DB_CONTAINER="nextcloud-db"
# mysql | postgres
NEXTCLOUD_DB_ENGINE="mysql"
# User that owns occ inside the app container (www-data on the official image).
NEXTCLOUD_OCC_USER="www-data"
# Path to occ inside the app container.
NEXTCLOUD_OCC_PATH="occ"
# Host paths on the HDD.
NEXTCLOUD_DATA_DIR="/mnt/hdd/nextcloud/data"
NEXTCLOUD_CONFIG_DIR="/mnt/hdd/nextcloud/config"

# How long Nextcloud stays in maintenance mode:
#   dumps_only -> only while the DB is dumped (seconds). Small chance a file
#                 written mid-run lands in S3 without its DB row; fixed on
#                 restore with `occ files:scan --all`.
#   full_run   -> for the whole backup, including the file sync. Fully
#                 consistent, but Nextcloud is unavailable for the duration.
NEXTCLOUD_MAINTENANCE_MODE="dumps_only"

# Regenerable preview cache; excluding it saves a lot of space and upload time.
NEXTCLOUD_EXCLUDE_PREVIEWS=1

# --- Safety guards -----------------------------------------------------------
# The mount point of the HDD. The backup refuses to run unless this is actually
# a mount point and the source dirs live on it. This is what stops an unmounted
# drive from being mirrored as "everything was deleted".
HDD_MOUNTPOINT="/mnt/hdd"
# Marker file placed in each source root by `s3-backup install-canaries`.
CANARY_FILE=".s3-backup-canary"
# Abort an Immich sync that wants to delete more than this many objects.
RCLONE_MAX_DELETE=1000
# Refuse to start if the staging filesystem has less than this much free space.
MIN_STAGING_FREE_MB=5120

# --- Runtime -----------------------------------------------------------------
# Where DB dumps are written before restic picks them up. Needs a few GB.
STAGING_DIR="/var/lib/s3-backup/staging"
# How many nights of dumps to keep locally for fast restores.
STAGING_KEEP=2
RUNNER_IMAGE="s3-backup-runner:1.0.0"
LOCK_FILE="/var/lock/s3-backup.lock"

# Upload tuning. Set BWLIMIT (e.g. "20M") to avoid saturating home upload.
RCLONE_TRANSFERS=8
RCLONE_CHECKERS=16
RCLONE_BWLIMIT=""

# --- Observability -----------------------------------------------------------
# node_exporter / Alloy textfile collector directory. Empty disables metrics.
METRICS_DIR="/var/lib/node_exporter/textfile_collector"
# Optional dead-man's-switch URL pinged on success (healthchecks.io etc).
HEALTHCHECK_URL=""
