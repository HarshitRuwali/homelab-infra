#!/usr/bin/env bash
# Stand-in for `docker` used by the smoke test. Records every invocation to
# $FAKE_DOCKER_LOG and fakes just enough behaviour to drive a full backup run.
set -uo pipefail
echo "$*" >> "${FAKE_DOCKER_LOG:-/tmp/fake-docker.log}"

STATE="${FAKE_DOCKER_STATE:-/tmp/fake-docker-state}"
mkdir -p "$STATE"

fake_sql_dump() {
  local kind="$1"
  echo "-- fake $kind dump generated by the smoke test"
  # Pad past verify_dump's 10 KiB floor. The padding must be incompressible,
  # otherwise gzip shrinks it below the threshold and the check trips on the
  # mock rather than on anything real.
  for i in $(seq 1 200); do
    echo "INSERT INTO t VALUES ($i, '$(head -c 96 /dev/urandom | base64 -w0)');"
  done
  if [[ "$kind" == postgres ]]; then
    echo "-- PostgreSQL database cluster dump complete"
  else
    echo "-- Dump completed on $(date)"
  fi
}

cmd="${1:-}"; shift || true

case "$cmd" in
  info) exit 0 ;;

  image)
    [[ "${1:-}" == "inspect" ]] && exit "${FAKE_IMAGE_MISSING:-0}"
    exit 0 ;;

  inspect)
    # -f '{{.State.Running}}' <name>  /  -f '{{.Config.Image}}' <name>
    fmt=""; while (( $# )); do case "$1" in -f) fmt="$2"; shift 2 ;; *) target="$1"; shift ;; esac; done
    case "$fmt" in
      *State.Running*) echo "${FAKE_CONTAINERS_RUNNING:-true}" ;;
      *Config.Image*)  echo "postgres:14-fake" ;;
      *) echo "" ;;
    esac
    exit 0 ;;

  exec)
    while (( $# )); do
      case "$1" in
        -u|-e) shift 2 ;;
        -i|-t|-it) shift ;;
        *) break ;;
      esac
    done
    container="$1"; shift
    joined="$*"
    case "$joined" in
      *pg_dumpall*)   fake_sql_dump postgres ;;
      *mysqldump*)    fake_sql_dump mysql ;;
      *pg_dump*)      fake_sql_dump postgres ;;
      *maintenance:mode*)
        state="on"; [[ "$joined" == *--off* ]] && state="off"
        echo "$state" > "$STATE/maintenance"
        echo "Maintenance mode $state" ;;
      *app:list*)     echo "Enabled:\n  - files: 1.0" ;;
      *) echo "fake-docker: unhandled exec: $joined" >&2 ;;
    esac
    exit 0 ;;

  run)
    # Skip flags until the image name, then dispatch on the tool.
    tool=""
    while (( $# )); do
      case "$1" in
        restic|rclone|secretsmanager|sts|jq) tool="$1"; shift; break ;;
        *) shift ;;
      esac
    done

    if [[ "$tool" == secretsmanager ]]; then
      # Record which credentials the caller authenticated with, so the test can
      # prove the bootstrap key is used for the fetch and the operational key
      # for S3.
      echo "${AWS_ACCESS_KEY_ID:-none}" > "$STATE/secret-fetch-key"
      echo fetched >> "$STATE/secret-fetches"
      [[ -n "${FAKE_SECRET_MISSING:-}" ]] && { echo "ResourceNotFoundException" >&2; exit 254; }
      # Assigned first: a JSON default inlined into ${VAR:-...} breaks brace
      # matching and leaks a stray '}'.
      default_payload='{"restic_password":"s3cr3t-from-asm","aws_access_key_id":"AKIAOPERATIONAL","aws_secret_access_key":"operational-secret"}'
      printf '%s' "${FAKE_SECRET_PAYLOAD:-$default_payload}"
      exit 0
    fi
    if [[ "$tool" == sts ]]; then echo "123456789012"; exit 0; fi
    [[ -n "$tool" ]] || exit 0
    sub="${1:-}"; shift || true

    if [[ "$tool" == jq ]]; then
      # A crude stand-in for jq, adequate for the fixed payloads this suite
      # uses. The real filter is exercised against the real image by
      # tests/secret-parse-test.sh.
      key=""
      while (( $# )); do
        case "$1" in --arg) key="$3"; shift 3 ;; *) shift ;; esac
      done
      sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
      exit 0
    fi

    echo "${AWS_ACCESS_KEY_ID:-none}" > "$STATE/runner-key"

    if [[ "$tool" == restic ]]; then
      case "$sub" in
        cat)
          # First call fails so `restic_ensure_repo` exercises the init path.
          [[ -f "$STATE/repo" ]] || exit 1
          echo '{"version":2}' ;;
        init)      touch "$STATE/repo"; echo "created restic repository" ;;
        backup)    echo "snapshot abc12345 saved"; touch "$STATE/backup-ran" ;;
        forget)    echo "no snapshots to remove"; touch "$STATE/forget-ran" ;;
        check)     echo "no errors were found" ;;
        snapshots) echo "[]" ;;
        stats)     echo "Total Size: 1.234 GiB" ;;
        restore)   echo "restored" ;;
        *)         echo "fake restic: $sub" ;;
      esac
      exit 0
    fi

    case "$sub" in
      lsd)  echo "          -1 2026-01-01 00:00:00        -1 restic" ;;
      sync) echo "Transferred: 0 / 0 Bytes, -, 0 Bytes/s"; touch "$STATE/sync-ran" ;;
      size) echo '{"count":1234,"bytes":567890123}' ;;
      check) echo "0 differences found" ;;
      copy) echo "copied" ;;
      version) echo "rclone v1.68.2" ;;
      *) echo "fake rclone: $sub" ;;
    esac
    exit 0 ;;

  rm) exit 0 ;;
  *)  exit 0 ;;
esac
