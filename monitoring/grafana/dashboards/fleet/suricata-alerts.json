            "properties": [
              {
                "id": "displayName",
                "value": "Source"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 12,
        "y": 12
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Alerts"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (src_ip) (count_over_time({host=\"opnsense\"} |= \"event_type\" |~ \"(?i)$search\" | json | event_type=\"alert\" | alert_severity=~\"$severity\" | __error__=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "src_ip": 0,
              "Alerts": 1
            },
            "renameByName": {
              "Value": "Alerts"
            }
          }
        }
      ],
      "title": "Top Sources",
      "type": "table",
      "id": 8
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "What was being talked to. The firewall's own LAN address on port 1900 is UPnP discovery, the usual source of SSDP noise.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dest_ip"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Destination"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dest_port"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Port"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "proto"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Proto"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Alerts"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (dest_ip, dest_port, proto) (count_over_time({host=\"opnsense\"} |= \"event_type\" |~ \"(?i)$search\" | json | event_type=\"alert\" | alert_severity=~\"$severity\" | __error__=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "dest_ip": 0,
              "dest_port": 1,
              "proto": 2,
              "Alerts": 3
            },
            "renameByName": {
              "Value": "Alerts"
            }
          }
        }
      ],
      "title": "Top Destinations",
      "type": "table",
      "id": 9
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "One line per alert, newest first: severity, signature, the flow, and the SID to look up or disable. Expand a line for every field Suricata sent, including flow_id and community_id for correlating with other tools.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{host=\"opnsense\"} |= \"event_type\" |~ \"(?i)$search\" | json | event_type=\"alert\" | alert_severity=~\"$severity\" | __error__=\"\" | line_format \"sev {{.alert_severity}}  {{.alert_signature}}  {{.src_ip}}:{{.src_port}} -> {{.dest_ip}}:{{.dest_port}} {{.proto}}  sid {{.alert_signature_id}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "title": "Recent Alerts",
      "type": "logs",
      "id": 10
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Suricata's own messages rather than alerts: rule reloads, and the flowbit warnings every reload prints when a rule depends on a category that is not enabled. A daily reload here is the proof the rule updates are running.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{host=\"opnsense\"} != \"event_type\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "title": "Engine Messages",
      "type": "logs",
      "id": 11
