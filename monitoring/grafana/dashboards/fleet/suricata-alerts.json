{
  "annotations": {
    "list": []
  },
  "description": "Suricata on OPNsense, alert-only, shipped as EVE syslog into Loki. Setup and the end-to-end check: security/docs/wiring, section 2.",
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Every Suricata alert in the selected range, after the Severity and Search filters above.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({host=\"opnsense\"} |= \"event_type\" |~ \"(?i)$search\" | json | event_type=\"alert\" | alert_severity=~\"$severity\" | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Alerts",
      "type": "stat",
      "id": 1
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Severity 1 alerts in the selected range. Ignores the Severity filter on purpose, so a narrowed view never hides these.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({host=\"opnsense\"} |= \"event_type\" | json | event_type=\"alert\" | alert_severity=\"1\" | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "High Severity",
      "type": "stat",
      "id": 2
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Distinct rules that fired in the selected range. A long tail of one-off signatures usually means a category worth reviewing.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count(sum by (alert_signature_id) (count_over_time({host=\"opnsense\"} |= \"event_type\" |~ \"(?i)$search\" | json | event_type=\"alert\" | alert_severity=~\"$severity\" | __error__=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Signatures",
      "type": "stat",
      "id": 3
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Distinct source addresses behind those alerts. For inbound alerts this counts internet hosts, so it can grow fast.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count(sum by (src_ip) (count_over_time({host=\"opnsense\"} |= \"event_type\" |~ \"(?i)$search\" | json | event_type=\"alert\" | alert_severity=~\"$severity\" | __error__=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Source Addresses",
      "type": "stat",
      "id": 4
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Everything the firewall sent, alerts or not, including rule reload messages. Zero across a range that includes a daily rule update means the syslog path is broken, not that the network is quiet.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({host=\"opnsense\"} [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Firewall Log Lines",
      "type": "stat",
      "id": 5
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Alerts per interval, by Suricata severity: 1 is high, 3 is low. A sudden wall of one colour is usually one noisy rule; check Top Signatures before assuming an incident.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity 1"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "High"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity 2"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Medium"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity 3"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Low"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (alert_severity) (count_over_time({host=\"opnsense\"} |= \"event_type\" |~ \"(?i)$search\" | json | event_type=\"alert\" | alert_severity=~\"$severity\" | __error__=\"\" [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "severity {{alert_severity}}"
        }
      ],
      "title": "Alerts Over Time",
      "type": "timeseries",
      "id": 6
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The rules doing the talking. A signature that fires constantly from a host you trust is a tuning job in OPNsense (Rules tab, disable by SID), not something to learn to ignore here.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alert_severity"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Severity"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "High",
                        "color": "red",
                        "index": 0
                      },
                      "2": {
                        "text": "Medium",
                        "color": "orange",
                        "index": 1
                      },
                      "3": {
                        "text": "Low",
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alert_signature"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Signature"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alert_category"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Category"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alert_signature_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "SID"
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Alerts"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(20, sum by (alert_severity, alert_signature, alert_category, alert_signature_id) (count_over_time({host=\"opnsense\"} |= \"event_type\" |~ \"(?i)$search\" | json | event_type=\"alert\" | alert_severity=~\"$severity\" | __error__=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "alert_severity": 0,
              "alert_signature": 1,
              "alert_category": 2,
              "alert_signature_id": 3,
              "Alerts": 4
            },
            "renameByName": {
              "Value": "Alerts"
            }
          }
        }
      ],
      "title": "Top Signatures",
      "type": "table",
      "id": 7
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Where alerts came from. Internal addresses are guests or LAN devices; map one to a guest with the Guest Traffic dashboard or the firewall's DHCP leases.",
      "fieldConfig": {
