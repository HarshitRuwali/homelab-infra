        "type": "custom",
        "query": "1,2,3",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "description": "Suricata severity: 1 high, 2 medium, 3 low."
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "description": "Regex matched against the raw alert JSON: an address, a SID, part of a signature. Case-insensitive."
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
