{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "description": "Distinct hosts seen in the last 6h. Wrapped in max_over_time because this stack is push-based: a dead host stops sending and would otherwise vanish from this count without a trace.",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(count by (host) (max_over_time(node_uname_info{host=~\"$host\"}[6h])))", "refId": "A"}],
      "title": "Hosts Reporting (6h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "avg(100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host=~\"$host\"}[5m]))))", "refId": "A"}],
      "title": "Average CPU",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "avg(100 * (1 - (node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"})))", "refId": "A"}],
      "title": "Average Memory",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "min(time() - node_boot_time_seconds{host=~\"$host\"})", "refId": "A"}],
      "title": "Shortest Uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host=~\"$host\"}[5m])))", "legendFormat": "{{host}}", "refId": "A"}],
      "title": "CPU Usage by Host",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * (1 - (node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"}))", "legendFormat": "{{host}}", "refId": "A"}],
      "title": "Memory Usage by Host",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",host=~\"$host\"}))", "legendFormat": "{{host}} /", "refId": "A"}],
      "title": "Root Disk Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (host) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\",host=~\"$host\"}[5m]))", "legendFormat": "{{host}} rx", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (host) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\",host=~\"$host\"}[5m]))", "legendFormat": "{{host}} tx", "refId": "B"}
      ],
      "title": "Network Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Hottest CPU package (t7920) or SoC (Pis) across the selected hosts. Only t7920 and the Pis have real sensors. The LXC guests report byte-for-byte copies of t7920's, since they share its kernel, so these panels select role=hypervisor and role=pi and ignore the rest.",
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 88}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 21},
      "id": 9,
      "links": [{"title": "t7920 hardware detail", "url": "/d/host-t7920/t7920"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(max by (host) (node_hwmon_temp_celsius{host=~\"$host\",role=\"hypervisor\",chip=~\"platform_coretemp_.*\",sensor=\"temp1\"}) or max by (host) (node_hwmon_temp_celsius{host=~\"$host\",role=\"pi\",chip=\"thermal_thermal_zone0\"}))", "refId": "A"}],
      "title": "Hottest CPU",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Hottest drive by its own SMART sensor (metal hosts only). fleet-smart-temperature-high fires above 60 C for 30 min.",
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 60}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 21},
      "id": 10,
      "links": [{"title": "t7920 hardware detail", "url": "/d/host-t7920/t7920"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(fleet_smart_temperature_celsius{host=~\"$host\"})", "refId": "A"}],
      "title": "Hottest Disk",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Slowest fitted Dell chassis fan on t7920, from roles/dell_fan_metrics. Under 500 RPM is a stalled fan. The fan map on the t7920 dashboard shows which one.",
      "fieldConfig": {"defaults": {"unit": "rotrpm", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 500}, {"color": "orange", "value": 3000}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 21},
      "id": 11,
      "links": [{"title": "t7920 hardware detail", "url": "/d/host-t7920/t7920"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "min(fleet_dell_fan_rpm{host=~\"$host\",fan!~\"CPU0|PSU|FB4\"})", "refId": "A"}],
      "title": "Slowest Chassis Fan",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Fitted Dell chassis fans under 500 RPM right now. Anything but 0 is fleet-hw-fan-stalled about to page.",
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 21},
      "id": 12,
      "links": [{"title": "t7920 hardware detail", "url": "/d/host-t7920/t7920"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(fleet_dell_fan_rpm{host=~\"$host\",fan!~\"CPU0|PSU|FB4\"} < 500) or vector(0)", "refId": "A"}],
      "title": "Fans Stalled",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Hottest CPU package per host (t7920) and SoC temperature (Pis). Dashed lines at 80 C and 88 C. Only t7920 and the Pis have real sensors. The LXC guests report byte-for-byte copies of t7920's, since they share its kernel, so these panels select role=hypervisor and role=pi and ignore the rest.",
      "fieldConfig": {"defaults": {"unit": "celsius", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 88}]}, "custom": {"thresholdsStyle": {"mode": "dashed"}}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "id": 13,
      "links": [{"title": "t7920 hardware detail", "url": "/d/host-t7920/t7920"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (host) (node_hwmon_temp_celsius{host=~\"$host\",role=\"hypervisor\",chip=~\"platform_coretemp_.*\",sensor=\"temp1\"})", "legendFormat": "{{host}} CPU", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (host) (node_hwmon_temp_celsius{host=~\"$host\",role=\"pi\",chip=\"thermal_thermal_zone0\"})", "legendFormat": "{{host}} SoC", "refId": "B"}
      ],
      "title": "CPU Temperature by Host",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Every fitted t7920 chassis fan by name, plus the rpi5 cooler on the right axis (it idles near 10000 RPM and would flatten the Dell fans on a shared axis). Detail and physical positions are on the t7920 dashboard.",
      "fieldConfig": {"defaults": {"unit": "rotrpm", "min": 0}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".*cooler"}, "properties": [{"id": "custom.axisPlacement", "value": "right"}]}]},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "id": 14,
      "links": [{"title": "t7920 hardware detail", "url": "/d/host-t7920/t7920"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "fleet_dell_fan_rpm{host=~\"$host\",fan!~\"CPU0|PSU|FB4\"}", "legendFormat": "{{host}} {{fan}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "node_hwmon_fan_rpm{host=~\"$host\",role=\"pi\"}", "legendFormat": "{{host}} cooler", "refId": "B"}
      ],
      "title": "Fan Speeds",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["system", "alloy", "prometheus", "hardware"],
  "templating": {
