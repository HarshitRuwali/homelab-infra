{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "Per-client traffic on the TP-Link Archer C5 at the Bangalore site (skullsaints' LAN). Polled every 60 s by roles/tplink_router_poll on skullsaints, which keeps its own daily copy in /var/lib/tplink-router-poll and hands the metrics to its Alloy, which ships them in batches.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [{"title": "Internet and Usage", "type": "link", "url": "/d/internet-usage/internet-and-usage", "icon": "dashboard", "keepTime": true}],
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": [], "title": "Overview", "type": "row", "id": 1},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "OK when the last poll read the router. Not polling when it failed, when someone was logged in to the router's web page (the poller then skips rather than log them out), or when skullsaints was on another network (the router MAC did not match, so the password was not sent). Reason: tplink_router_poll_skipped.", "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "Not polling", "color": "red"}, "1": {"text": "OK", "color": "green"}}}]}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "tplink_router_poll_success{router=\"blr\"}", "refId": "A", "instant": true, "range": false}], "title": "Poller", "type": "stat", "id": 2},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Seconds since the poller last ran. It runs every 60 s on skullsaints; more than a few minutes means skullsaints is off, asleep or cannot reach central.", "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 180}, {"color": "red", "value": 600}]}}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "time() - tplink_router_poll_timestamp_seconds{router=\"blr\"}", "refId": "A", "instant": true, "range": false}], "title": "Last poll", "type": "stat", "id": 3},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Clients the router marks active now.", "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum(max by (mac) (tplink_router_client_info{router=\"blr\"}))", "refId": "A", "instant": true, "range": false}], "title": "Clients online", "type": "stat", "id": 4},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "All Wi-Fi clients together over the selected time range, from the per-client Wi-Fi counters.", "fieldConfig": {"defaults": {"unit": "bytes", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum(increase(tplink_router_wifi_client_bytes_total{router=\"blr\",mac=~\"$client\",direction=\"download\"}[$__range]))", "refId": "A", "instant": true, "range": false}], "title": "Downloaded", "type": "stat", "id": 5},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "All Wi-Fi clients together over the selected time range.", "fieldConfig": {"defaults": {"unit": "bytes", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum(increase(tplink_router_wifi_client_bytes_total{router=\"blr\",mac=~\"$client\",direction=\"upload\"}[$__range]))", "refId": "A", "instant": true, "range": false}], "title": "Uploaded", "type": "stat", "id": 6},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Every counter on the router restarts from zero when it reboots; the usage panels account for that.", "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "tplink_router_uptime_seconds{router=\"blr\"}", "refId": "A", "instant": true, "range": false}], "title": "Router uptime", "type": "stat", "id": 7},
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "panels": [], "title": "Usage per client", "type": "row", "id": 8},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "id": 9, "type": "table", "title": "Usage per client in the selected range", "description": "Bytes per Wi-Fi client over the time range at the top right. Download is what the router sent to the client. Counters restart when a client reconnects or the router reboots; increase() adds across those restarts. Wired clients are not counted (none were seen).", "gridPos": {"h": 10, "w": 10, "x": 0, "y": 6}, "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"align": "auto", "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byRegexp", "options": "Download|Upload|Total"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "basic"}}]}]}, "options": {"showHeader": true, "sortBy": [{"displayName": "Total", "desc": true}], "footer": {"show": true, "reducer": ["sum"], "fields": ""}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (name, mac) (increase(tplink_router_wifi_client_bytes_total{router=\"blr\",mac=~\"$client\",direction=\"download\"}[$__range]))", "refId": "A", "instant": true, "range": false, "format": "table"}, {"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (name, mac) (increase(tplink_router_wifi_client_bytes_total{router=\"blr\",mac=~\"$client\",direction=\"upload\"}[$__range]))", "refId": "B", "instant": true, "range": false, "format": "table"}], "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"name": "Client", "mac": "MAC", "Value #A": "Download", "Value #B": "Upload"}, "indexByName": {"name": 0, "mac": 1, "Value #A": 2, "Value #B": 3}}}, {"id": "calculateField", "options": {"mode": "binary", "binary": {"left": "Download", "operator": "+", "right": "Upload"}, "alias": "Total", "replaceFields": false}}]},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Download plus upload per client, one bar per hour.", "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": []}, "gridPos": {"h": 10, "w": 14, "x": 10, "y": 6}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (name, mac) (increase(tplink_router_wifi_client_bytes_total{router=\"blr\",mac=~\"$client\"}[1h]))", "refId": "A", "legendFormat": "{{name}} ({{mac}})", "interval": "1h"}], "title": "Hourly usage per client", "type": "timeseries", "id": 10},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Router to client, 5 minute average.", "fieldConfig": {"defaults": {"unit": "bps", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (name, mac) (rate(tplink_router_wifi_client_bytes_total{router=\"blr\",mac=~\"$client\",direction=\"download\"}[5m])) * 8", "refId": "A", "legendFormat": "{{name}} ({{mac}})"}], "title": "Download rate per client", "type": "timeseries", "id": 11},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Client to router, 5 minute average.", "fieldConfig": {"defaults": {"unit": "bps", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (name, mac) (rate(tplink_router_wifi_client_bytes_total{router=\"blr\",mac=~\"$client\",direction=\"upload\"}[5m])) * 8", "refId": "A", "legendFormat": "{{name}} ({{mac}})"}], "title": "Upload rate per client", "type": "timeseries", "id": 12},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Download plus upload per client per day. Central The Prometheus variable picks the tier: the central one keeps 7 days, the network one 90 days; skullsaints keeps 30 days of raw samples in /var/lib/tplink-router-poll.", "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": []}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (name, mac) (increase(tplink_router_wifi_client_bytes_total{router=\"blr\",mac=~\"$client\"}[1d]))", "refId": "A", "legendFormat": "{{name}} ({{mac}})", "interval": "1d"}], "title": "Daily usage per client", "type": "timeseries", "id": 13},
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "panels": [], "title": "Wi-Fi", "type": "row", "id": 14},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "id": 15, "type": "table", "title": "Clients", "description": "Every client in the router's table. Active 1 means connected now. Unknown names are devices that sent no hostname.", "gridPos": {"h": 8, "w": 10, "x": 0, "y": 33}, "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": []}, "options": {"showHeader": true, "sortBy": [{"displayName": "Active", "desc": true}]}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "tplink_router_client_info{router=\"blr\"}", "refId": "A", "instant": true, "range": false, "format": "table"}], "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "router": true, "instance": true, "job": true, "host": true, "role": true}, "renameByName": {"name": "Client", "ip": "IP", "mac": "MAC", "band": "Band", "Value": "Active"}, "indexByName": {"name": 0, "ip": 1, "mac": 2, "band": 3, "Value": 4}}}]},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "As the router hears each client. Above -65 dBm is good, below -80 dBm is weak.", "fieldConfig": {"defaults": {"unit": "dBm", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}}, "overrides": []}, "gridPos": {"h": 8, "w": 14, "x": 10, "y": 33}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "max by (name, mac) (tplink_router_wifi_client_signal_dbm{router=\"blr\",mac=~\"$client\"})", "refId": "A", "legendFormat": "{{name}} ({{mac}})"}], "title": "Signal per client", "type": "timeseries", "id": 16},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Last data rate the router used toward each client: an upper bound on that client's speed.", "fieldConfig": {"defaults": {"unit": "bps", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 41}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "max by (name, mac) (tplink_router_wifi_client_link_rate_bits{router=\"blr\",mac=~\"$client\",direction=\"download\"})", "refId": "A", "legendFormat": "{{name}} ({{mac}})"}], "title": "Link rate per client (router to client)", "type": "timeseries", "id": 17},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Frames the router had to resend; a rise with weak signal points at a bad spot for that client.", "fieldConfig": {"defaults": {"unit": "pps", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 41}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (name, mac) (rate(tplink_router_wifi_client_retransmissions_total{router=\"blr\",mac=~\"$client\"}[5m]))", "refId": "A", "legendFormat": "{{name}} ({{mac}})"}], "title": "Retransmissions per client", "type": "timeseries", "id": 18},
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 49}, "panels": [], "title": "Router", "type": "row", "id": 19},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "The router's own IPv4 online state (PPPoE).", "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}]}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 0, "y": 50}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "min(tplink_router_wan_online{router=\"blr\",family=\"ipv4\"})", "refId": "A", "instant": true, "range": false}], "title": "Internet", "type": "stat", "id": 20},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "", "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 4, "y": 50}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "tplink_router_cpu_percent{router=\"blr\"}", "refId": "A", "instant": true, "range": false}], "title": "Router CPU", "type": "stat", "id": 21},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "", "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.85}]}}, "overrides": []}, "gridPos": {"h": 4, "w": 4, "x": 8, "y": 50}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "1 - tplink_router_memory_bytes{router=\"blr\",state=\"free\"} / ignoring(state) tplink_router_memory_bytes{router=\"blr\",state=\"total\"}", "refId": "A", "instant": true, "range": false}], "title": "Router memory used", "type": "stat", "id": 22},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "Whether the router's remote log setting still points at skullsaints' current address and port. It goes red if skullsaints gets a different DHCP address: fix the router's remote log setting, or reserve the address.", "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "Not reaching skullsaints", "color": "red"}, "1": {"text": "To skullsaints", "color": "green"}}}]}, "overrides": []}, "gridPos": {"h": 3, "w": 12, "x": 0, "y": 58}, "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "max(tplink_router_log_forwarding{router=\"blr\"})", "refId": "A", "instant": true, "range": false}], "title": "Router log forwarding", "type": "stat", "id": 23},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "For comparison only. The router's internet counter misses traffic it forwards in hardware: a 20 MB download moved it by 8 MB while the Wi-Fi counter moved 22.7 MB (2026-11-20). Use the Wi-Fi figures for usage.", "fieldConfig": {"defaults": {"unit": "bps", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 50}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (direction) (rate(tplink_router_wan_bytes_total{router=\"blr\"}[5m])) * 8", "refId": "A", "legendFormat": "router WAN {{direction}}"}, {"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "sum by (direction) (rate(tplink_router_wifi_client_bytes_total{router=\"blr\"}[5m])) * 8", "refId": "B", "legendFormat": "all Wi-Fi clients {{direction}}"}], "title": "Router's own internet counter vs Wi-Fi clients", "type": "timeseries", "id": 24},
    {"datasource": {"type": "prometheus", "uid": "${ds}"}, "description": "", "fieldConfig": {"defaults": {"unit": "percent", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "min": 0}, "overrides": []}, "gridPos": {"h": 4, "w": 12, "x": 0, "y": 54}, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${ds}"}, "expr": "tplink_router_cpu_percent{router=\"blr\"}", "refId": "A", "legendFormat": "CPU %"}], "title": "Router CPU and memory", "type": "timeseries", "id": 25},
