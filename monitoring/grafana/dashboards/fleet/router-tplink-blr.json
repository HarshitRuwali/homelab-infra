    {"datasource": {"type": "grafana-postgresql-datasource", "uid": "net-history"}, "description": "Wi-Fi download plus upload per client of the Bangalore router. Source: PostgreSQL net_history (datasource Network history), rolled up hourly by net-history and kept forever; always the last 24 months, whatever the time picker says.", "fieldConfig": {"defaults": {"unit": "decbytes", "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "spanNulls": true, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": 0}, "min": 0}, "overrides": []}, "gridPos": {"h": 9, "w": 14, "x": 0, "y": 83}, "hideTimeOverride": true, "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"], "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "grafana-postgresql-datasource", "uid": "net-history"}, "editorMode": "code", "format": "time_series", "rawQuery": true, "rawSql": "SELECT month::timestamp AS time, coalesce(name, '?') || ' ' || mac AS metric, total_bytes AS value FROM net.monthly_client WHERE month >= (date_trunc('month', now() AT TIME ZONE 'Asia/Kolkata') - interval '23 months')::date AND router = 'blr' ORDER BY 1", "refId": "A"}], "timeFrom": "2y", "title": "Usage per client per month", "type": "timeseries", "id": 32},
