      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (host, state) (node_systemd_unit_state{state=~\"active|failed|inactive\",host=~\"$host\"})", "legendFormat": "{{host}} {{state}}", "refId": "A"}],
      "title": "Systemd Units by State",
