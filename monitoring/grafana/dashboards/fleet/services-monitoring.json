      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(count_over_time({host=~\"$host\"} |~ \"(?i)(error|failed|fatal|panic)\" [5m]))", "refId": "A"}],
      "title": "Error Logs 5m",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Every Docker container in the fleet, one row each, with what it costs and how settled it is.\n\nRestarts 30m is the column to scan first: anything above 1 is a container fighting with something, and Uptime resetting between refreshes means the same thing.\n\nThis table is empty unless cAdvisor can see per-container cgroups. Membership of the `docker` group is NOT sufficient: cAdvisor also needs root for /run/containerd/containerd.sock, which roles/alloy_collector grants with a systemd drop-in on Docker hosts. If this is blank while Docker Logs at the bottom is not, that drop-in is missing.",
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}}, "unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "CPU"}, "properties": [{"id": "unit", "value": "percentunit"}, {"id": "min", "value": 0}, {"id": "max", "value": 1}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}]}, {"matcher": {"id": "byName", "options": "Memory"}, "properties": [{"id": "unit", "value": "bytes"}]}, {"matcher": {"id": "byName", "options": "Uptime"}, "properties": [{"id": "unit", "value": "s"}]}, {"matcher": {"id": "byName", "options": "Restarts 30m"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "color-background"}}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}]}]},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 5},
      "id": 11,
      "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "Restarts 30m"}]},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (host, name) (rate(container_cpu_usage_seconds_total{host=~\"$host\",name!=\"\"}[5m]))", "format": "table", "instant": true, "range": false, "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (host, name) (container_memory_working_set_bytes{host=~\"$host\",name!=\"\"})", "format": "table", "instant": true, "range": false, "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "time() - max by (host, name) (container_start_time_seconds{host=~\"$host\",name!=\"\"})", "format": "table", "instant": true, "range": false, "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "max by (host, name) (changes(container_start_time_seconds{host=~\"$host\",name!=\"\"}[30m]))", "format": "table", "instant": true, "range": false, "refId": "D"}
      ],
      "title": "Container Inventory",
      "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"host": 0, "name": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4, "Value #D": 5}, "renameByName": {"Value #A": "CPU", "Value #B": "Memory", "Value #C": "Uptime", "Value #D": "Restarts 30m", "host": "Host", "name": "Container"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
