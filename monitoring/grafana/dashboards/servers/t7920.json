    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "coretemp Package id 0, the Xeon Gold 6138's own sensor. 83 C is the part's rated max (fleet-hw-cpu-temperature-high after 15 min); 90 C pages (fleet-hw-cpu-temperature-critical after 5 min); TjMax, where it throttles itself, is 93 C.",
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 83}, {"color": "red", "value": 90}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 13},
      "id": 21,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "node_hwmon_temp_celsius{host=\"t7920\",chip=\"platform_coretemp_0\",sensor=\"temp1\"}", "refId": "A"}],
      "title": "CPU 0 Package",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "coretemp Package id 1, the Xeon Gold 6138's own sensor. 83 C is the part's rated max (fleet-hw-cpu-temperature-high after 15 min); 90 C pages (fleet-hw-cpu-temperature-critical after 5 min); TjMax, where it throttles itself, is 93 C. Socket 1 normally runs 10-15 C hotter than socket 0: it sits behind CPU 0 and breathes its exhaust (see the fan map).",
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 83}, {"color": "red", "value": 90}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 13},
      "id": 22,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "node_hwmon_temp_celsius{host=\"t7920\",chip=\"platform_coretemp_1\",sensor=\"temp1\"}", "refId": "A"}],
      "title": "CPU 1 Package",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Highest of the Dell SMM board sensors temp3, temp8, temp9 and temp10. The BIOS reports no type for any of them, so ambient, memory and VR cannot be told apart. temp1 and temp2 are left out because they track the CPU packages. fleet-hw-board-temperature-high fires above 65 C for 30 min.",
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 55}, {"color": "red", "value": 65}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 13},
      "id": 23,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(node_hwmon_temp_celsius{host=\"t7920\",chip=\"platform_dell_smm_hwmon\",sensor!~\"temp1|temp2\"})", "refId": "A"}],
      "title": "Hottest Board Sensor",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Slowest fitted chassis fan (CPU0, PSU and FB4 have no working fan and are excluded, as in fleet-hw-fan-stalled). The BIOS never parks these: under 500 RPM is a stalled fan and pages after 5 min.",
      "fieldConfig": {"defaults": {"unit": "rotrpm", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 500}, {"color": "orange", "value": 3000}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 13},
      "id": 24,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "min(fleet_dell_fan_rpm{host=\"t7920\",fan!~\"CPU0|PSU|FB4\"})", "refId": "A"}],
      "title": "Slowest Fan",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Every Dell chassis fan at its physical position, laid out as the two fan figures in Dell's Precision 7920 Tower Owner's Manual (Removing and installing components, figures 1 and 2). Speeds are read from the firmware every 30 s by roles/dell_fan_metrics and named from SMBIOS. Grey outlined positions are ones this machine's BIOS does not list. CPU0 is a header Dell leaves empty on this model; the PSU fan has no tachometer on SMM; FB4 is listed by the BIOS but this machine has no rear drive bays, so no fan is fitted there. Red under 500 RPM (stalled), orange over 3000.",
      "fieldConfig": {"defaults": {"unit": "rotrpm", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 500}, {"color": "orange", "value": 3000}]}}, "overrides": [{"matcher": {"id": "byName", "options": "CPU0"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "no fan fitted", "color": "#5a5a5a", "index": 0}}}]}]}, {"matcher": {"id": "byName", "options": "PSU"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "not reported", "color": "#5a5a5a", "index": 0}}}]}]}]},
      "gridPos": {"h": 16, "w": 24, "x": 0, "y": 18},
