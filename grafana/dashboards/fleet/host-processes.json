      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "node_procs_blocked{host=\"$host\"}", "refId": "A"}],
      "title": "Blocked on I/O",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "htop's per-core meters. One bar per core.\n\nRead the SPREAD, not just the height: every core evenly busy is a parallel workload, one core pinned while the rest idle is a single-threaded process that will not go faster on a bigger box.",
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "gridPos": {"h": 11, "w": 12, "x": 0, "y": 4},
      "id": 8,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 10},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * (1 - rate(node_cpu_seconds_total{mode=\"idle\",host=\"$host\"}[2m]))", "legendFormat": "cpu{{cpu}}", "refId": "A"}
      ],
      "title": "CPU per Core",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "htop's memory and swap meters.\n\n`RAM used` is derived from MemAvailable, so it excludes reclaimable cache: it is what is genuinely unavailable, not what `free` reports. `clamp_min` on the swap total keeps a swapless host from dividing by zero and showing NaN.",
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "gridPos": {"h": 11, "w": 12, "x": 12, "y": 4},
      "id": 9,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 10},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * (1 - (node_memory_MemAvailable_bytes{host=\"$host\"} / node_memory_MemTotal_bytes{host=\"$host\"}))", "legendFormat": "RAM used", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * (node_memory_Cached_bytes{host=\"$host\"} + node_memory_Buffers_bytes{host=\"$host\"}) / node_memory_MemTotal_bytes{host=\"$host\"}", "legendFormat": "cache + buffers", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * (1 - (node_memory_SwapFree_bytes{host=\"$host\"} / clamp_min(node_memory_SwapTotal_bytes{host=\"$host\"}, 1)))", "legendFormat": "swap used", "refId": "C"}
      ],
      "title": "Memory and Swap",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Stacked and normalised by core count, so the stack total is host CPU percent. This is htop's per-core colouring, aggregated: high `iowait` means the disk is the bottleneck, high `system` means kernel work, high `steal` means the hypervisor is not giving you the CPU you asked for.",
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"stacking": {"mode": "normal", "group": "A"}, "fillOpacity": 40}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 10,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\",host=\"$host\"}[2m])) / on() group_left count(count by (cpu) (node_cpu_seconds_total{host=\"$host\"}))", "legendFormat": "{{mode}}", "refId": "A"}
      ],
      "title": "CPU by Mode",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
