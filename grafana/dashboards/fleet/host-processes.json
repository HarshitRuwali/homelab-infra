  "panels": [
{
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "htop's load average. Compare against the core count to the right: load equal to cores means fully busy, above it means work is queuing.",
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "node_load1{host=\"$host\"}", "refId": "A"}],
      "title": "Load 1 / 5 / 15",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 4, "y": 0},
