      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(count by (cpu) (node_cpu_seconds_total{host=\"$host\"}))", "refId": "A"}],
      "title": "Cores",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
