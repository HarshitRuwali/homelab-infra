        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "node_memory_SwapTotal_bytes{host=\"$host\"} - node_memory_SwapFree_bytes{host=\"$host\"}", "legendFormat": "swap used", "refId": "D"}
