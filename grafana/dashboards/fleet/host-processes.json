    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "htop's process list. CPU% is per-core-equivalent, so 100 means one core saturated and 400 means four.\n\nGrouped by command name, so every worker of the same program is one row. That is why a 32-worker service shows one line with a large Count rather than 32 near-identical rows.",
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "CPU%"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}, {"id": "min", "value": 0}, {"id": "max", "value": 100}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "MEM%"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}, {"id": "min", "value": 0}, {"id": "max", "value": 100}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "RSS"}, "properties": [{"id": "unit", "value": "bytes"}]}, {"matcher": {"id": "byName", "options": "Age"}, "properties": [{"id": "unit", "value": "s"}]}]},
      "gridPos": {"h": 13, "w": 24, "x": 0, "y": 23},
      "id": 12,
      "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "CPU%"}]},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{host=\"$host\"}[2m])) * 100", "format": "table", "instant": true, "range": false, "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (groupname) (namedprocess_namegroup_memory_bytes{memtype=\"resident\",host=\"$host\"})", "format": "table", "instant": true, "range": false, "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "100 * sum by (groupname) (namedprocess_namegroup_memory_bytes{memtype=\"resident\",host=\"$host\"}) / on() group_left scalar(node_memory_MemTotal_bytes{host=\"$host\"})", "format": "table", "instant": true, "range": false, "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (groupname) (namedprocess_namegroup_num_procs{host=\"$host\"})", "format": "table", "instant": true, "range": false, "refId": "D"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (groupname) (namedprocess_namegroup_num_threads{host=\"$host\"})", "format": "table", "instant": true, "range": false, "refId": "E"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (groupname) (namedprocess_namegroup_open_filedesc{host=\"$host\"})", "format": "table", "instant": true, "range": false, "refId": "F"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "time() - min by (groupname) (namedprocess_namegroup_oldest_start_time_seconds{host=\"$host\"})", "format": "table", "instant": true, "range": false, "refId": "G"}
      ],
      "title": "Process Table",
      "type": "table",
      "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"groupname": 0, "Value #A": 1, "Value #C": 2, "Value #B": 3, "Value #D": 4, "Value #E": 5, "Value #F": 6, "Value #G": 7}, "renameByName": {"groupname": "Process", "Value #A": "CPU%", "Value #B": "RSS", "Value #C": "MEM%", "Value #D": "Count", "Value #E": "Threads", "Value #F": "FDs", "Value #G": "Age"}}}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
