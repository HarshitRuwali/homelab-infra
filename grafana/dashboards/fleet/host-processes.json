    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Processes in the run queue right now. Persistently above the core count is the same signal as a high load average, seen instantaneously.",
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 17, "y": 0},
