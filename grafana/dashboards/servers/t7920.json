    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "SMART disk health from roles/smart_metrics, refreshed every 15 minutes by a systemd timer (not scraped every 15s, which would keep waking the spinning disk and stop it parking its heads). This is the only host in the estate that can report SMART at all.",
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "FAILED", "color": "red"}, "1": {"text": "OK", "color": "green"}}}]}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 13},
      "id": 7,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "min(fleet_smart_device_health_ok{host=\"t7920\"})", "refId": "A"}],
      "title": "Disks Healthy",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 13},
      "id": 8,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "fleet_smart_devices_total{host=\"t7920\"}", "refId": "A"}],
      "title": "SMART Devices",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Reallocated + pending + offline-uncorrectable, summed across disks. Any non-zero value is worth investigating; pending sectors are the most urgent because that data is already unreadable.",
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 13},
      "id": 9,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(fleet_smart_reallocated_sectors{host=\"t7920\"}) + sum(fleet_smart_pending_sectors{host=\"t7920\"}) + sum(fleet_smart_offline_uncorrectable{host=\"t7920\"})", "refId": "A"}],
      "title": "Bad Sectors",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Rated write endurance consumed. This is wear, not failure: an SSD at 100% still works, it just has no warranty margin left. Spare-block exhaustion is the metric that actually predicts read-only mode.",
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 85}, {"color": "red", "value": 95}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 13},
      "id": 10,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(fleet_smart_nvme_percentage_used_ratio{host=\"t7920\"}) * 100", "refId": "A"}],
      "title": "NVMe Life Used",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Alert fires above 60 C sustained for 30 minutes.",
      "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "id": 11,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "fleet_smart_temperature_celsius{host=\"t7920\"}", "legendFormat": "{{device}} {{model}}", "refId": "A"}
      ],
      "title": "Disk Temperature",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "The classic leading indicators of a dying spinning disk. A stable non-zero count is tolerable; a rising one means order a replacement.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "id": 12,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "fleet_smart_reallocated_sectors{host=\"t7920\"}", "legendFormat": "{{device}} reallocated", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "fleet_smart_pending_sectors{host=\"t7920\"}", "legendFormat": "{{device}} pending", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "fleet_smart_offline_uncorrectable{host=\"t7920\"}", "legendFormat": "{{device}} uncorrectable", "refId": "C"}
      ],
      "title": "Sector Health (SATA)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "A cumulative lifetime counter that never resets, so read the SLOPE, not the value. Flat means a past event. Rising means the SATA cable or backplane is degrading now, which is what the alert keys on (increase over 24h), not the absolute count.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "id": 13,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "fleet_smart_crc_errors{host=\"t7920\"}", "legendFormat": "{{device}}", "refId": "A"}
